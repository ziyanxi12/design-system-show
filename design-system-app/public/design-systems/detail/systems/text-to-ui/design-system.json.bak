     "adapter": "runtime-render",
     "files": [
      {
       "path": "packages/components-html/src/index.js#renderRuntimeHtmlComponent(dialog)",
       "lang": "html",
       "code": "<style>body{display:block!important;padding:24px 28px!important;background:#fff}\n.tp{display:flex;flex-direction:column;gap:22px;font-family:var(--font-sans)}\n.tp-sec{display:flex;flex-direction:column;gap:10px;max-width:100%}\n.tp-l{font-size:12px;color:#8a8a8a}.tp-l i{font-style:normal;color:#b5b5b5;margin-left:4px}\n.tp-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp-it{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:64px;max-width:100%}\n.tp-cap{font-size:11px;color:#9a9a9a;line-height:14px;white-space:nowrap}\n.tp-it>*:first-child{max-width:100%}\n/* 规范仓库的组件示例集（renderRuntimeHtmlComponent）用到的外层排版类，仓库精简版里没有对应样式，这里补齐 */\n.tp :is(.tui-runtime-core-gallery,.tui-runtime-form-field-states,.tui-runtime-titlebar-gallery,.tui-feedback-specimens,.tui-list-card-group,.tui-runtime-titlebar-layouts){display:flex;flex-direction:column;gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-avatar-pair,.tui-runtime-structural-grid,.tui-runtime-surface-grid,.tui-runtime-state-grid,.tui-runtime-chips-gallery,.tui-badge-group,.tui-primary-navigation-items){display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp .tui-runtime-form-field-states{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-form-field-states)>[data-surface-context]{flex:1 1 280px;min-width:0}\n.tp :is(.tui-runtime-structural-cell,.tui-runtime-state-cell,.tui-feedback-specimen,.tui-runtime-avatar-pair>div,[data-surface-context]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}\n.tp [data-surface-context]{padding:16px;border-radius:12px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}\n.tp [data-surface-context=\"gray\"]{background:var(--color-bg-subtle,#0000000C);box-shadow:none}\n.tp [data-surface-context]>*:not(.tui-runtime-surface-label){width:100%}\n.tp :is(.tui-runtime-surface-label,.tui-runtime-titlebar-scenario-slots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">规范示例 <i>specimens</i></div><div class=\"tui-overlay-specimens\" data-component=\"dialog\"><div class=\"tui-overlay-example\" data-overlay-example=\"dialog-single\">\n    <button class=\"tui-button\" type=\"button\" data-variant=\"secondary\" data-overlay-trigger=\"dialog-single\" data-typography-role=\"body-l\" onclick=\"const l=this.nextElementSibling;l.hidden=false;const d=l.querySelector('.tui-dialog');d.dataset.state='open';d.focus()\">打开单按钮对话弹窗</button>\n    <div class=\"tui-overlay-layer\" id=\"dialog-single\" data-overlay-id=\"dialog-single\" hidden>\n      <div class=\"tui-overlay-backdrop\" aria-hidden=\"true\"></div>\n      <section class=\"tui-component tui-dialog \" data-component=\"dialog\" data-renderer-key=\"dialog\" data-logical-component=\"Dialog/Default\" data-variant=\"single\" data-state=\"open\" data-framework=\"html\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dialog-single-title\" aria-describedby=\"dialog-single-description\" tabindex=\"-1\" onkeydown=\"if(event.key==='Escape'){event.preventDefault();const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()}\">\n        <header class=\"tui-dialog__header\" data-slot=\"titlebar\"><h4 id=\"dialog-single-title\" data-slot=\"title\" data-typography-role=\"title-s\">更新完成</h4></header>\n        <div class=\"tui-dialog__content\"><p id=\"dialog-single-description\" data-slot=\"description\" data-typography-role=\"body-m\">应用已经更新到最新版本。</p></div>\n        <footer class=\"tui-dialog__actions\" data-slot=\"actions\" data-action-layout=\"single\"><button class=\"tui-button\" type=\"button\" data-variant=\"primary\" data-overlay-action=\"confirm\" data-typography-role=\"body-l\" onclick=\"const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()\">知道了</button></footer>\n      </section>\n    </div>\n  </div><div class=\"tui-overlay-example\" data-overlay-example=\"dialog-double\">\n    <button class=\"tui-button\" type=\"button\" data-variant=\"secondary\" data-overlay-trigger=\"dialog-double\" data-typography-role=\"body-l\" onclick=\"const l=this.nextElementSibling;l.hidden=false;const d=l.querySelector('.tui-dialog');d.dataset.state='open';d.focus()\">打开双按钮对话弹窗</button>\n    <div class=\"tui-overlay-layer\" id=\"dialog-double\" data-overlay-id=\"dialog-double\" hidden>\n      <div class=\"tui-overlay-backdrop\" aria-hidden=\"true\"></div>\n      <section class=\"tui-component tui-dialog \" data-component=\"dialog\" data-renderer-key=\"dialog\" data-logical-component=\"Dialog/Default\" data-variant=\"double\" data-state=\"open\" data-framework=\"html\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dialog-double-title\" aria-describedby=\"dialog-double-description\" tabindex=\"-1\" onkeydown=\"if(event.key==='Escape'){event.preventDefault();const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()}\">\n        <header class=\"tui-dialog__header\" data-slot=\"titlebar\"><h4 id=\"dialog-double-title\" data-slot=\"title\" data-typography-role=\"title-s\">确认更新？</h4></header>\n        <div class=\"tui-dialog__content\"><p id=\"dialog-double-description\" data-slot=\"description\" data-typography-role=\"body-m\">更新期间应用需要重新启动。</p></div>\n        <footer class=\"tui-dialog__actions\" data-slot=\"actions\" data-action-layout=\"double\"><button class=\"tui-button\" type=\"button\" data-variant=\"secondary\" data-overlay-action=\"cancel\" data-typography-role=\"body-l\" onclick=\"const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()\">取消</button><button class=\"tui-button\" type=\"button\" data-variant=\"primary\" data-overlay-action=\"confirm\" data-typography-role=\"body-l\" onclick=\"const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()\">确认</button></footer>\n      </section>\n    </div>\n  </div><div class=\"tui-overlay-example\" data-overlay-example=\"dialog-triple\">\n    <button class=\"tui-button\" type=\"button\" data-variant=\"secondary\" data-overlay-trigger=\"dialog-triple\" data-typography-role=\"body-l\" onclick=\"const l=this.nextElementSibling;l.hidden=false;const d=l.querySelector('.tui-dialog');d.dataset.state='open';d.focus()\">打开三按钮对话弹窗</button>\n    <div class=\"tui-overlay-layer\" id=\"dialog-triple\" data-overlay-id=\"dialog-triple\" hidden>\n      <div class=\"tui-overlay-backdrop\" aria-hidden=\"true\"></div>\n      <section class=\"tui-component tui-dialog \" data-component=\"dialog\" data-renderer-key=\"dialog\" data-logical-component=\"Dialog/Default\" data-variant=\"triple\" data-state=\"open\" data-framework=\"html\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dialog-triple-title\" aria-describedby=\"dialog-triple-description\" tabindex=\"-1\" onkeydown=\"if(event.key==='Escape'){event.preventDefault();const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()}\">\n        <header class=\"tui-dialog__header\" data-slot=\"titlebar\"><h4 id=\"dialog-triple-title\" data-slot=\"title\" data-typography-role=\"title-s\">保存更改？</h4></header>\n        <div class=\"tui-dialog__content\"><p id=\"dialog-triple-description\" data-slot=\"description\" data-typography-role=\"body-m\">你可以先保存草稿，稍后再继续编辑。</p></div>\n        <footer class=\"tui-dialog__actions\" data-slot=\"actions\" data-action-layout=\"triple\"><button class=\"tui-button\" type=\"button\" data-variant=\"primary\" data-overlay-action=\"confirm\" data-typography-role=\"body-l\" onclick=\"const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()\">确认</button><button class=\"tui-button\" type=\"button\" data-variant=\"secondary\" data-overlay-action=\"third\" data-typography-role=\"body-l\" onclick=\"const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()\">保存草稿</button><button class=\"tui-button\" type=\"button\" data-variant=\"secondary\" data-overlay-action=\"cancel\" data-typography-role=\"body-l\" onclick=\"const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()\">取消</button></footer>\n      </section>\n    </div>\n  </div></div></div></div>"
      },
      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-title-s-weight:var(--font-weight-700);--font-weight-700:700;--type-title-s-leading:var(--line-height-24);--line-height-24:24px;--type-title-s-size:var(--font-size-20);--font-size-20:20px;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--space-5:16px;--gap-button-group:var(--space-3);--space-3:8px;--height-modal-footer:var(--size-17);--size-17:80px;--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--padding-modal-content-x:var(--space-6);--space-6:24px;--space-4:12px;--padding-modal-header-x:var(--space-6);--padding-modal-header-top:var(--space-3);--height-dialog-header:var(--size-14);--size-14:56px;--shadow-4:0 10px 50px 0 rgb(0 0 30 / 30%);--color-dialog-bg:var(--color-surface-raised);--color-surface-raised:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-dialog:var(--radius-5);--radius-5:16px;--width-dialog:400px;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--color-button-secondary-hover-bg:var(--color-secondary-hover);--color-secondary-hover:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--color-button-secondary-bg:var(--color-secondary);--color-secondary:var(--color-neutral-dark-05);--color-primary:var(--color-brand-100);--state-layer-pressed:var(--color-neutral-dark-10);--state-layer-hover:var(--color-neutral-dark-05);--color-primary-text:var(--color-neutral-light-100);--letter-spacing-normal:0;--radius-button:var(--radius-3);--radius-3:8px;--gap-button-icon-label:var(--space-3);--padding-button-x:var(--space-5);--height-button:var(--size-11);--size-11:40px}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button { height: var(--height-button); padding: 0 var(--padding-button-x); display: inline-flex; align-items: center; justify-content: center; gap: var(--gap-button-icon-label); border: 0px; border-radius: var(--radius-button); color: var(--color-primary-text); background: var(--color-primary); cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); letter-spacing: var(--letter-spacing-normal); white-space: nowrap; }\n.tui-button[data-variant=\"primary\"] { color: var(--color-primary-text); background: var(--color-primary); }\n.tui-button[data-variant=\"primary\"]:hover:not(:disabled), .tui-button[data-variant=\"primary\"][data-state=\"hover\"] { background: linear-gradient(var(--state-layer-hover), var(--state-layer-hover)), var(--color-primary); }\n.tui-button[data-variant=\"primary\"]:active:not(:disabled), .tui-button[data-variant=\"primary\"][data-state=\"pressed\"] { background: linear-gradient(var(--state-layer-pressed), var(--state-layer-pressed)), var(--color-primary); }\n.tui-button[data-variant=\"secondary\"] { color: var(--color-brand-100); background: var(--color-button-secondary-bg); }\n.tui-button[data-variant=\"secondary\"]:hover:not(:disabled), .tui-button[data-variant=\"secondary\"][data-state=\"hover\"] { background: var(--color-button-secondary-hover-bg); }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-button:disabled, .tui-button[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-overlay-example { display: grid; justify-items: start; gap: var(--space-4); }\n.tui-overlay-specimens { display: flex; flex-wrap: wrap; gap: var(--space-4); }\n.tui-overlay-layer { z-index: 1000; position: fixed; inset: 0px; display: grid; place-items: center; padding: var(--space-6); pointer-events: none; }\n.tui-overlay-layer[hidden] { display: none; }\n.tui-overlay-backdrop { position: absolute; inset: 0px; background: var(--color-overlay-scrim, rgb(0 0 0 / 30%)); pointer-events: auto; }\n.tui-dialog { z-index: 1; position: relative; width: min(calc(100vw - 48px), var(--width-dialog)); display: grid; overflow: hidden; border: 0px; border-radius: var(--radius-dialog); color: var(--color-text); background: var(--color-dialog-bg); box-shadow: var(--shadow-4); pointer-events: auto; }\n.tui-dialog__header { position: relative; min-height: var(--height-dialog-header); display: grid; place-items: center; padding: var(--padding-modal-header-top) var(--padding-modal-header-x) 0; }\n.tui-dialog__header h4 { min-width: 0px; max-width: 100%; margin: 0px; text-align: center; overflow-wrap: anywhere; }\n.tui-dialog__content { display: grid; gap: var(--space-4); margin: 0px; padding: var(--space-4) var(--padding-modal-content-x) var(--space-5); color: var(--color-text-muted); text-align: center; }\n.tui-dialog__content > p { margin: 0px; white-space: normal; overflow-wrap: anywhere; }\n.tui-dialog__actions { min-height: var(--height-modal-footer); display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0px, 1fr); align-items: end; gap: var(--gap-button-group); padding: 0 var(--space-5) var(--space-5); }\n.tui-dialog__actions[data-action-layout=\"single\"] { grid-auto-flow: row; grid-template-columns: minmax(0px, 1fr); }\n.tui-dialog__actions[data-action-layout=\"triple\"] { grid-auto-flow: row; grid-template-columns: minmax(0px, 1fr); align-items: stretch; }\n.tui-dialog__actions .tui-button { width: 100%; min-width: 0px; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-generated [data-typography-role=\"title-s\"], [data-typography-role=\"title-s\"] { font-size: var(--type-title-s-size); line-height: var(--type-title-s-leading); font-weight: var(--type-title-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
