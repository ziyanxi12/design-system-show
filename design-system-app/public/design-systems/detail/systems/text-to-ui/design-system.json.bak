      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--color-primary:var(--color-brand-100);--color-brand-100:#0A59F7FF;--color-icon:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--icon-size-md:var(--size-6);--size-6:20px;--color-icon-muted:var(--color-neutral-dark-60);--color-brand-10:#0A59F719;--color-focus-ring:var(--color-brand-100);--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--state-layer-hover:var(--color-neutral-dark-05);--color-text:var(--color-neutral-dark-90);--radius-subtab:var(--radius-3);--radius-3:8px;--space-4:12px;--space-3:8px;--height-tree-item:var(--size-11);--size-11:40px;--space-1:2px;--color-surface:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--radius-card:var(--radius-4);--radius-4:12px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--space-2:4px}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-tree-view { min-width: 220px; display: grid; gap: var(--space-1); padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-card); color: var(--color-text); background: var(--color-surface); }\n.tui-tree-view__nodes, .tui-tree-view__group { display: grid; gap: var(--space-1); margin: 0px; padding: 0px; list-style: none; }\n.tui-tree-view__node { display: grid; gap: var(--space-1); }\n.tui-tree-view__item { width: 100%; min-height: var(--height-tree-item); display: flex; align-items: center; gap: var(--space-3); padding-block: 0px; padding-inline-start: calc(var(--space-3) + var(--tree-indent, 0px)); padding-inline-end: var(--space-4); border: 0px; border-radius: var(--radius-subtab); color: var(--color-text); background: transparent; text-align: start; font: inherit; cursor: pointer; }\n.tui-tree-view__item:hover { background: var(--state-layer-hover); }\n.tui-tree-view__item:disabled { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-tree-view__item:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: -2px; }\n.tui-tree-view__item.is-selected { color: var(--color-primary); background: var(--color-brand-10); }\n.tui-tree-view__item.is-selected:hover:not(:disabled) { background: linear-gradient(var(--color-neutral-dark-05), var(--color-neutral-dark-05)), var(--color-brand-10); }\n.tui-tree-view__chevron { width: var(--icon-size-md); height: var(--icon-size-md); display: grid; place-items: center; flex: 0 0 var(--icon-size-md); color: var(--color-icon-muted); }\n.tui-tree-view__chevron.has-children .tui-icon { transition: transform 0.16s; }\n.tui-tree-view__chevron.has-children.is-expanded .tui-icon { transform: rotate(90deg); }\n.tui-tree-view__icon { width: var(--icon-size-md); height: var(--icon-size-md); display: grid; place-items: center; flex: 0 0 var(--icon-size-md); color: var(--color-icon); }\n.tui-tree-view__item.is-selected .tui-tree-view__icon, .tui-tree-view__item.is-selected .tui-tree-view__chevron { color: var(--color-primary); }\n.tui-tree-view__label { min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-tree-view__trailing { min-width: 0px; margin-inline-start: auto; overflow: hidden; color: var(--color-text-muted); font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); white-space: nowrap; text-overflow: ellipsis; }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
      }
     ]
    }
