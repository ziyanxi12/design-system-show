       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-s-weight:var(--font-weight-400);--font-weight-400:400;--type-body-s-leading:var(--line-height-14);--line-height-14:14px;--type-body-s-size:var(--font-size-12);--font-size-12:12px;--type-body-m-weight:var(--font-weight-400);--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--radio-size:var(--size-6);--size-6:20px;--color-danger:var(--color-function-danger-100);--color-function-danger-100:#E84026FF;--radius-full:999px;--notification-dot-sm:var(--size-2);--size-2:6px;--color-icon-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--icon-size-md:var(--size-6);--color-text-muted:var(--color-neutral-dark-60);--gap-menu-item-content:var(--space-3);--space-3:8px;--space-1:2px;--icon-size-lg:var(--size-7);--size-7:24px;--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--switch-height:var(--size-6);--switch-width:var(--size-11);--size-11:40px;--color-primary:var(--color-brand-100);--color-surface:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--color-neutral-dark-20:#00000033;--color-primary-text:var(--color-neutral-light-100);--icon-size-sm:var(--size-5);--size-5:16px;--radius-checkbox:var(--radius-1);--radius-1:4px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--checkbox-size:var(--size-6);--radius-list-item:var(--radius-3);--radius-3:8px;--gap-choice-label:var(--space-3);--height-list-item:var(--size-11);--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--color-text-subtle:var(--color-neutral-dark-40);--color-neutral-dark-40:#00000066;--state-layer-pressed:var(--color-neutral-dark-10);--state-layer-hover:var(--color-neutral-dark-05);--height-list-item-triple-line:var(--size-17);--size-17:80px;--height-list-item-double-line:var(--size-14);--size-14:56px;--height-list-item-single-line:var(--size-13);--size-13:48px;--layout-navigation-divider-width:0.5px}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-list-card-group { width: 100%; display: grid; }\n.tui-list-card-group > .tui-list-card + .tui-list-card { position: relative; }\n.tui-list-card-group > .tui-list-card + .tui-list-card::before { content: \"\"; position: absolute; inset-block-start: 0px; inset-inline: var(--space-3); height: var(--layout-navigation-divider-width); background: var(--color-neutral-dark-20); pointer-events: none; }\n.tui-list-card { position: relative; min-height: var(--height-list-item-single-line); width: 100%; display: flex; align-items: center; gap: var(--gap-menu-item-content); padding-inline: var(--space-3); padding-block: 0px; border: 0px; border-radius: var(--radius-list-item); color: var(--color-text); background: transparent; text-align: left; font-family: var(--font-sans); cursor: pointer; }\n.tui-list-card[data-lines=\"2\"] { min-height: var(--height-list-item-double-line); }\n.tui-list-card[data-lines=\"3\"] { min-height: var(--height-list-item-triple-line); }\n.tui-list-card:hover:not(:disabled), .tui-list-card[data-state=\"hover\"] { background: var(--state-layer-hover); }\n.tui-list-card:active:not(:disabled), .tui-list-card[data-state=\"pressed\"] { background: var(--state-layer-pressed); }\n.tui-list-card:disabled, .tui-list-card[data-state=\"disabled\"] { color: var(--color-text-subtle); cursor: not-allowed; }\n.tui-list-card .tui-item__leading { width: var(--icon-size-lg); height: var(--icon-size-lg); display: grid; place-items: center; flex: 0 0 var(--icon-size-lg); color: var(--color-icon-muted); }\n.tui-list-card .tui-item__leading > .tui-icon { width: 100%; height: 100%; }\n.tui-list-card .tui-item__content { min-width: 0px; flex: 1 1 0%; display: grid; gap: var(--space-1); }\n.tui-list-card .tui-item__content [data-slot=\"title\"], .tui-list-card .tui-item__content [data-slot=\"description\"] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.tui-list-card .tui-item__content [data-slot=\"description\"], .tui-list-card .tui-item__content [data-slot=\"supporting\"], .tui-list-card > [data-slot=\"trailing\"] { color: var(--color-text-muted); }\n.tui-list-card .tui-item__trailing { min-width: 0px; display: inline-flex; align-items: center; justify-content: flex-end; gap: var(--gap-menu-item-content); color: var(--color-text-muted); }\n.tui-list-card .tui-item__trailing--text-arrow { color: var(--color-text-muted); }\n.tui-list-card .tui-item__trailing--icon > .tui-icon, .tui-list-card .tui-item__trailing--text-arrow > .tui-icon, .tui-list-card .tui-item__trailing--notification-arrow > .tui-icon { width: var(--icon-size-md); height: var(--icon-size-md); }\n.tui-list-card .tui-item__trailing--icon, .tui-list-card .tui-item__trailing--notification-arrow { color: var(--color-icon-muted); }\n.tui-list-card .tui-item__notification-dot { width: var(--notification-dot-sm); height: var(--notification-dot-sm); border-radius: var(--radius-full); background: var(--color-danger); }\n.tui-choice { min-width: 0px; color: var(--color-text); font-family: var(--font-sans); }\n.tui-choice input { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; pointer-events: none; }\n.tui-checkbox, .tui-switch { min-height: var(--height-list-item); display: grid; grid-template-columns: auto minmax(0px, 1fr) auto; align-items: center; gap: var(--gap-choice-label); padding: var(--space-3); border-radius: var(--radius-list-item); cursor: pointer; }\n.tui-checkbox:hover > .tui-checkbox__indicator, .tui-checkbox[data-state=\"hover\"] > .tui-checkbox__indicator, .tui-radio-group label:hover > .tui-radio__indicator { outline: 2px solid var(--color-neutral-dark-05); outline-offset: 0px; }\n.tui-checkbox__indicator { width: var(--checkbox-size); height: var(--checkbox-size); box-sizing: border-box; position: relative; display: grid; place-items: center; flex: 0 0 var(--checkbox-size); border: 1px solid var(--color-border); background: var(--color-surface); }\n.tui-radio__indicator { width: var(--radio-size); height: var(--radio-size); box-sizing: border-box; position: relative; display: grid; place-items: center; flex: 0 0 var(--radio-size); border: 1px solid var(--color-border); background: var(--color-surface); }\n.tui-checkbox__indicator { border-radius: var(--radius-checkbox); }\n.tui-radio__indicator { border-radius: var(--radius-full); }\n.tui-checkbox input:checked + .tui-checkbox__indicator { border-color: var(--color-primary); background: var(--color-primary); }\n.tui-checkbox__indicator > .tui-icon { width: var(--icon-size-sm); height: var(--icon-size-sm); display: block; overflow: visible; color: var(--color-primary-text); visibility: hidden; transform: translateY(-2px); }\n.tui-checkbox input:checked + .tui-checkbox__indicator > .tui-icon { visibility: visible; }\n.tui-radio input:checked + .tui-radio__indicator, .tui-radio-group input:checked + .tui-radio__indicator, .tui-item__trailing input:checked + .tui-radio__indicator { border-color: var(--color-primary); background: var(--color-primary); }\n.tui-radio input:checked + .tui-radio__indicator::after, .tui-radio-group input:checked + .tui-radio__indicator::after, .tui-item__trailing input:checked + .tui-radio__indicator::after { content: \"\"; position: absolute; inset: 50% auto auto 50%; width: 8px; height: 8px; border-radius: var(--radius-full); background: var(--color-primary-text); transform: translate(-50%, -50%); }\n.tui-switch__track { width: var(--switch-width); height: var(--switch-height); position: relative; box-sizing: border-box; display: block; flex: 0 0 var(--switch-width); border-radius: var(--radius-full); background: var(--color-neutral-dark-20); transition: background 0.18s; }\n.tui-switch__track::after { content: \"\"; position: absolute; inset-block-start: 2px; inset-inline-start: 2px; width: calc(var(--switch-height) - 4px); height: calc(var(--switch-height) - 4px); border-radius: var(--radius-full); background: var(--color-surface); transition: transform 0.18s; }\n.tui-switch input:checked + .tui-switch__track { background: var(--color-primary); }\n.tui-switch input:checked + .tui-switch__track::after { transform: translateX(calc(var(--switch-width) - var(--switch-height))); }\n.tui-choice input:focus-visible + .tui-checkbox__indicator, .tui-choice input:focus-visible + .tui-radio__indicator, .tui-choice input:focus-visible + .tui-switch__track { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-item__leading { width: var(--icon-size-lg); height: var(--icon-size-lg); display: grid; place-items: center; flex: 0 0 var(--icon-size-lg); color: var(--color-icon-muted); }\n.tui-item__leading > .tui-icon { width: 100%; height: 100%; }\n.tui-item__content { min-width: 0px; flex: 1 1 0%; display: grid; gap: var(--space-1); }\n.tui-item__content [data-slot=\"title\"], .tui-item__content [data-slot=\"description\"] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.tui-item__content [data-slot=\"description\"], .tui-item__content [data-slot=\"supporting\"], .tui-item > [data-slot=\"trailing\"] { color: var(--color-text-muted); }\n.tui-item__trailing { min-width: 0px; display: inline-flex; align-items: center; justify-content: flex-end; gap: var(--gap-menu-item-content); color: var(--color-text-muted); }\n.tui-item__trailing--text-arrow { color: var(--color-text-muted); }\n.tui-item__trailing--icon > .tui-icon, .tui-item__trailing--text-arrow > .tui-icon, .tui-item__trailing--notification-arrow > .tui-icon { width: var(--icon-size-md); height: var(--icon-size-md); }\n.tui-item__trailing--icon, .tui-item__trailing--notification-arrow { color: var(--color-icon-muted); }\n.tui-item__notification-dot { width: var(--notification-dot-sm); height: var(--notification-dot-sm); border-radius: var(--radius-full); background: var(--color-danger); }\n.tui-item__trailing .tui-radio__indicator { width: var(--radio-size); height: var(--radio-size); display: grid; place-items: center; }\n.tui-item__trailing.tui-checkbox, .tui-item__trailing.tui-switch { min-height: 0px; width: auto; padding: 0px; display: inline-flex; background: transparent; }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-icon--regular[data-icon-size=\"24\"] [stroke] { stroke-width: 1.5; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-generated [data-typography-role=\"body-s\"], [data-typography-role=\"body-s\"] { font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); font-weight: var(--type-body-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
      }
     ]
    }
   },
   {
    "id": "dialog",
    "name": "Dialog",
    "desc": "容器类 · Dialog/Default",
    "props": [
     {
