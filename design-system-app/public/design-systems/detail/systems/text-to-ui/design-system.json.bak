lots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">规范示例 <i>specimens</i></div><div class=\"tui-runtime-core-gallery\"><p class=\"tui-runtime-note\">Tag Entry 是一个通用变体：按内容面设置 surface=\"white\" 或 \"gray\" 即可复用；此处直接展示组件。自由文本可保留，Enter 打开建议，方向键或点击选项后生成可移除标签。</p><div class=\"tui-runtime-surface-pair\"><div data-surface-context=\"white\"><span class=\"tui-runtime-surface-label\">白色内容面 · 灰色输入面</span><label class=\"tui-component tui-input\" data-component=\"input\" data-renderer-key=\"input\" data-logical-component=\"Input/White Surface/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-surface=\"white\"><input data-slot=\"value\" data-typography-role=\"body-l\" type=\"text\" placeholder=\"项目名称\" aria-label=\"项目名称\" /></label></div><div data-surface-context=\"gray\"><span class=\"tui-runtime-surface-label\">灰色内容面 · 白色输入面</span><label class=\"tui-component tui-input\" data-component=\"input\" data-renderer-key=\"input\" data-logical-component=\"Input/White Surface/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-surface=\"gray\"><input data-slot=\"value\" data-typography-role=\"body-l\" type=\"text\" placeholder=\"项目名称\" aria-label=\"项目名称\" /></label></div></div><div class=\"tui-component tui-input tui-input--tag-entry\" data-component=\"input\" data-renderer-key=\"input\" data-logical-component=\"Input/Tag Entry/Default\" data-variant=\"tag-entry\" data-state=\"default\" data-framework=\"html\" data-surface=\"gray\" data-input-tag-entry role=\"group\" aria-labelledby=\"tui-input-tag-entry-1-label\"><label class=\"tui-input-tag-entry__label\" id=\"tui-input-tag-entry-1-label\" for=\"tui-input-tag-entry-1\" data-slot=\"label\" data-typography-role=\"body-l\">参与成员</label><div class=\"tui-input-tag-entry__editor\"><div class=\"tui-input-tag-entry__tags\" data-slot=\"tags\" role=\"list\" aria-label=\"参与成员已选\"><span class=\"tui-component tui-chip tui-input-tag-entry__chip\" data-component=\"chips\" data-logical-component=\"Chips/Default\" data-variant=\"text-only-closable\" data-state=\"default\" data-framework=\"html\" data-tag-value=\"林娜\"><span class=\"tui-chip__leading\" data-slot=\"leading\"></span><span class=\"tui-chip__label\" data-slot=\"label\" data-typography-role=\"body-m\">林娜</span><button class=\"tui-chip__close\" data-slot=\"close\" data-remove-tag type=\"button\" aria-label=\"移除 林娜\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" data-icon-alias=\"action/close\" data-icon-size=\"16\" data-display-size-token=\"size/16\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m6 6 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></span></div><input id=\"tui-input-tag-entry-1\" class=\"tui-input-tag-entry__input\" data-slot=\"value\" data-typography-role=\"body-l\" type=\"text\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"tui-input-tag-entry-1-suggestions\" aria-labelledby=\"tui-input-tag-entry-1-label\" autocomplete=\"off\" placeholder=\"输入姓名后按 Enter\" /><div id=\"tui-input-tag-entry-1-suggestions\" class=\"tui-advanced-menu__panel tui-input-tag-entry__menu\" role=\"listbox\" aria-label=\"参与成员建议\" hidden><button id=\"tui-input-tag-entry-1-suggestions-option-1\" class=\"tui-advanced-menu__item\" type=\"button\" role=\"option\" aria-selected=\"false\" data-option-value=\"林娜\" data-typography-role=\"body-l\">林娜</button><button id=\"tui-input-tag-entry-1-suggestions-option-2\" class=\"tui-advanced-menu__item\" type=\"button\" role=\"option\" aria-selected=\"false\" data-option-value=\"王昊\" data-typography-role=\"body-l\">王昊</button><button id=\"tui-input-tag-entry-1-suggestions-option-3\" class=\"tui-advanced-menu__item\" type=\"button\" role=\"option\" aria-selected=\"false\" data-option-value=\"陈佳\" data-typography-role=\"body-l\">陈佳</button><button id=\"tui-input-tag-entry-1-suggestions-option-4\" class=\"tui-advanced-menu__item\" type=\"button\" role=\"option\" aria-selected=\"false\" data-option-value=\"周明\" data-typography-role=\"body-l\">周明</button><div class=\"tui-input-tag-entry__empty\" data-empty-state hidden>无匹配项</div></div></div></div></div></div></div>"
      },
      {
       "path": "packages/component-styles/src/index.css",
