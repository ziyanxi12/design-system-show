       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-title-s-weight:var(--font-weight-700);--font-weight-700:700;--type-title-s-leading:var(--line-height-24);--line-height-24:24px;--type-title-s-size:var(--font-size-20);--font-size-20:20px;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-input-bg-on-default:var(--color-neutral-dark-05);--space-5:16px;--height-modal-footer:var(--size-17);--size-17:80px;--padding-modal-content-x:var(--space-6);--space-6:24px;--padding-modal-content-y:var(--space-0);--space-0:0px;--icon-size-md:var(--size-6);--size-6:20px;--height-button:var(--size-11);--size-11:40px;--gap-button-group:var(--space-3);--space-3:8px;--gap-form-field:var(--space-5);--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--space-4:12px;--padding-modal-header-x:var(--space-6);--padding-modal-header-top:var(--space-3);--height-dialog-header:var(--size-14);--size-14:56px;--color-modal-bg-white:var(--color-surface-raised);--color-surface-raised:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--width-modal-md:640px;--shadow-5:0 10px 55px 0 rgb(0 0 30 / 25%);--shadow-4:0 10px 50px 0 rgb(0 0 30 / 30%);--color-dialog-bg:var(--color-surface-raised);--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-dialog:var(--radius-5);--radius-5:16px;--width-dialog:400px;--space-7:32px;--radius-input:var(--radius-3);--radius-3:8px;--padding-select-x:var(--space-4);--height-input:var(--size-11);--gap-field-label:var(--space-3);--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--state-layer-hover:var(--color-neutral-dark-05);--color-icon-muted:var(--color-neutral-dark-60);--radius-icon-button:var(--radius-3);--size-icon-button:var(--size-11);--icon-size-sm:var(--size-5);--size-5:16px;--space-2:4px;--color-text-subtle:var(--color-neutral-dark-40);--color-neutral-dark-40:#00000066;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--color-input-focus-bg-on-default:var(--color-neutral-dark-05);--color-input-hover-bg-on-default:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--padding-search-x:var(--space-4);--color-button-secondary-hover-bg:var(--color-secondary-hover);--color-secondary-hover:var(--color-neutral-dark-10);--color-button-secondary-bg:var(--color-secondary);--color-secondary:var(--color-neutral-dark-05);--color-primary:var(--color-brand-100);--state-layer-pressed:var(--color-neutral-dark-10);--color-primary-text:var(--color-neutral-light-100);--letter-spacing-normal:0;--radius-button:var(--radius-3);--gap-button-icon-label:var(--space-3);--padding-button-x:var(--space-5)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button { height: var(--height-button); padding: 0 var(--padding-button-x); display: inline-flex; align-items: center; justify-content: center; gap: var(--gap-button-icon-label); border: 0px; border-radius: var(--radius-button); color: var(--color-primary-text); background: var(--color-primary); cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); letter-spacing: var(--letter-spacing-normal); white-space: nowrap; }\n.tui-button[data-variant=\"primary\"] { color: var(--color-primary-text); background: var(--color-primary); }\n.tui-button[data-variant=\"primary\"]:hover:not(:disabled), .tui-button[data-variant=\"primary\"][data-state=\"hover\"] { background: linear-gradient(var(--state-layer-hover), var(--state-layer-hover)), var(--color-primary); }\n.tui-button[data-variant=\"primary\"]:active:not(:disabled), .tui-button[data-variant=\"primary\"][data-state=\"pressed\"] { background: linear-gradient(var(--state-layer-pressed), var(--state-layer-pressed)), var(--color-primary); }\n.tui-button[data-variant=\"secondary\"] { color: var(--color-brand-100); background: var(--color-button-secondary-bg); }\n.tui-button[data-variant=\"secondary\"]:hover:not(:disabled), .tui-button[data-variant=\"secondary\"][data-state=\"hover\"] { background: var(--color-button-secondary-hover-bg); }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-button:disabled, .tui-button[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-input, .tui-search { position: relative; width: 100%; min-width: 0px; height: var(--height-input); display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--padding-search-x); color: var(--color-text); border: 1px solid transparent; border-radius: var(--radius-input); background: var(--color-input-bg-on-default); font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-input:hover { background: var(--color-input-hover-bg-on-default); }\n.tui-input:focus-within { background: var(--color-input-focus-bg-on-default); }\n.tui-search:has(.tui-search__scope) { gap: 0px; padding: 0px; border: 0px; }\n.tui-search:not([data-surface=\"gray\"]) { background: var(--color-input-bg-on-default); }\n.tui-search:not(:has(.tui-search__scope)):hover:not([data-state=\"disabled\"]) { background: var(--color-neutral-dark-05); }\n.tui-search:not(:has(.tui-search__scope)):focus-within { background: var(--color-input-focus-bg-on-default); }\n.tui-search input::placeholder { color: var(--color-text-muted); }\n.tui-input[data-state=\"disabled\"], .tui-search[data-state=\"disabled\"], .tui-input:has(input:disabled), .tui-search:has(input:disabled) { opacity: var(--state-disabled-opacity); }\n.tui-input input, .tui-search input { min-width: 0px; flex: 1 1 0%; padding: 0px; border: 0px; outline: 0px; color: inherit; background: transparent; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-input input::placeholder { color: var(--color-text-subtle); }\n.tui-search:has([data-slot=\"advanced-search\"]):not(:has(.tui-search__scope)) { padding-right: var(--space-2); }\n.tui-icon-button svg { width: var(--icon-size-sm); height: var(--icon-size-sm); display: block; }\n.tui-icon-button { width: var(--size-icon-button); height: var(--size-icon-button); padding: 0px; display: inline-grid; place-items: center; border: 0px; border-radius: var(--radius-icon-button); color: var(--color-icon-muted); background: transparent; cursor: pointer; }\n.tui-icon-button:hover { color: var(--color-text); background: var(--state-layer-hover); }\n.tui-icon-button:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 1px; }\n.tui-textarea, .tui-field, .tui-native-select { width: 100%; display: grid; gap: var(--gap-field-label); color: var(--color-text); font-family: var(--font-sans); }\n.tui-overlay-example { display: grid; justify-items: start; gap: var(--space-4); }\n.tui-specimen-controls { display: flex; flex-wrap: wrap; align-items: end; gap: var(--space-4); }\n.tui-specimen-controls label { display: grid; gap: var(--gap-field-label); color: var(--color-text); }\n.tui-specimen-controls select { min-height: var(--height-input); padding-inline: var(--padding-select-x); border: 1px solid transparent; border-radius: var(--radius-input); color: var(--color-text); background: var(--color-input-bg-on-default); font: inherit; }\n.tui-overlay-layer { z-index: 1000; position: fixed; inset: 0px; display: grid; place-items: center; padding: var(--space-6); pointer-events: none; }\n.tui-overlay-layer[hidden] { display: none; }\n.tui-overlay-backdrop { position: absolute; inset: 0px; background: var(--color-overlay-scrim, rgb(0 0 0 / 30%)); pointer-events: auto; }\n.tui-overlay-layer[data-mode=\"non-modal\"] { place-items: start center; padding-top: max(var(--space-7), 8vh); }\n.tui-overlay-layer[data-mode=\"non-modal\"] .tui-overlay-backdrop { display: none; }\n.tui-dialog { z-index: 1; position: relative; width: min(calc(100vw - 48px), var(--width-dialog)); display: grid; overflow: hidden; border: 0px; border-radius: var(--radius-dialog); color: var(--color-text); background: var(--color-dialog-bg); box-shadow: var(--shadow-4); pointer-events: auto; }\n.tui-dialog--semi { width: min(calc(100vw - 48px), var(--width-modal-md)); background: var(--color-modal-bg-white); box-shadow: var(--shadow-5); }\n.tui-overlay-layer[data-size=\"m\"] .tui-dialog--semi { width: min(calc(100vw - 48px), var(--width-modal-md)); }\n.tui-overlay-layer[data-surface=\"white\"] .tui-dialog--semi { background: var(--color-modal-bg-white); }\n.tui-dialog__header { position: relative; min-height: var(--height-dialog-header); display: grid; place-items: center; padding: var(--padding-modal-header-top) var(--padding-modal-header-x) 0; }\n.tui-dialog__header h4 { min-width: 0px; max-width: 100%; margin: 0px; text-align: center; overflow-wrap: anywhere; }\n.tui-dialog__content { display: grid; gap: var(--space-4); margin: 0px; padding: var(--space-4) var(--padding-modal-content-x) var(--space-5); color: var(--color-text-muted); text-align: center; }\n.tui-dialog__content > p { margin: 0px; white-space: normal; overflow-wrap: anywhere; }\n.tui-dialog__form { display: grid; gap: var(--gap-form-field); text-align: start; }\n.tui-dialog__actions { min-height: var(--height-modal-footer); display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0px, 1fr); align-items: end; gap: var(--gap-button-group); padding: 0 var(--space-5) var(--space-5); }\n.tui-dialog__actions .tui-button { width: 100%; min-width: 0px; }\n.tui-dialog--semi .tui-dialog__header { grid-template-columns: minmax(0, 1fr) var(--height-button); place-items: center stretch; }\n.tui-dialog--semi .tui-dialog__header h4 { text-align: start; }\n.tui-dialog--semi .tui-dialog__close { width: var(--height-button); height: var(--height-button); justify-self: end; }\n.tui-dialog--semi .tui-dialog__header { padding-right: var(--space-5); }\n.tui-dialog--semi .tui-dialog__close > .tui-icon { width: var(--icon-size-md); height: var(--icon-size-md); }\n.tui-dialog--semi .tui-dialog__content { padding: var(--padding-modal-content-y) var(--padding-modal-content-x); text-align: start; }\n.tui-dialog--semi .tui-dialog__actions { min-height: var(--height-modal-footer); display: flex; justify-content: flex-end; padding: 0 var(--space-5) var(--space-5); }\n.tui-dialog--semi .tui-dialog__actions .tui-button { width: auto; }\n.tui-overlay-layer[data-surface=\"white\"] [data-field-control] { background: var(--color-input-bg-on-default); }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-generated [data-typography-role=\"title-s\"], [data-typography-role=\"title-s\"] { font-size: var(--type-title-s-size); line-height: var(--type-title-s-leading); font-weight: var(--type-title-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
