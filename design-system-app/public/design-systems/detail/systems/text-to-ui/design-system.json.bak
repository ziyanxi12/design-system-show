ata-value=\"已归档\" data-typography-role=\"body-l\">已归档</button></div></div></div><div data-surface-context=\"gray\"><span class=\"tui-runtime-surface-label\">灰色内容面 · 白色选择面</span><div class=\"tui-component tui-select\" data-component=\"select\" data-renderer-key=\"select\" data-logical-component=\"Select/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-surface=\"gray\"><span data-slot=\"label\" data-typography-role=\"body-m\">状态</span><button class=\"tui-select__trigger\" type=\"button\" role=\"button\" aria-haspopup=\"listbox\" aria-expanded=\"false\"><span data-slot=\"value\" data-typography-role=\"body-m\">进行中</span><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" data-icon-alias=\"navigation/chevron-down\" data-icon-size=\"16\" data-display-size-token=\"size/16\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><div class=\"tui-select__menu\" role=\"listbox\" hidden><button type=\"button\" role=\"option\" aria-selected=\"true\" data-value=\"进行中\" data-typography-role=\"body-l\">进行中</button><button type=\"button\" role=\"option\" aria-selected=\"false\" data-value=\"已完成\" data-typography-role=\"body-l\">已完成</button><button type=\"button\" role=\"option\" aria-selected=\"false\" data-value=\"已归档\" data-typography-role=\"body-l\">已归档</button></div></div></div></div></div></div>"
