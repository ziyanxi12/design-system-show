       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-title-s-weight:var(--font-weight-700);--font-weight-700:700;--type-title-s-leading:var(--line-height-24);--line-height-24:24px;--type-title-s-size:var(--font-size-20);--font-size-20:20px;--type-subtitle-m-weight:var(--font-weight-500);--font-weight-500:500;--type-subtitle-m-leading:var(--line-height-20);--line-height-20:20px;--type-subtitle-m-size:var(--font-size-16);--font-size-16:16px;--type-body-l-weight:var(--font-weight-400);--font-weight-400:400;--type-body-l-leading:var(--line-height-20);--type-body-l-size:var(--font-size-16);--state-window-unfocus-opacity:var(--opacity-40);--opacity-40:0.4;--color-titlebar-unfocus-bg:transparent;--icon-size-sm:var(--size-5);--size-5:16px;--icon-size-lg:var(--size-7);--size-7:24px;--color-icon:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--icon-size-md:var(--size-6);--size-6:20px;--color-text-subtle:var(--color-neutral-dark-40);--color-neutral-dark-40:#00000066;--state-layer-hover:var(--color-neutral-dark-05);--color-text:var(--color-neutral-dark-90);--radius-popup-menu-item:var(--radius-1);--radius-1:4px;--space-3:8px;--gap-button-icon-label:var(--space-3);--height-menu-item:var(--size-11);--size-11:40px;--shadow-2:0 0 20px 0 rgb(0 0 30 / 8%);--color-surface-raised:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--radius-card:var(--radius-4);--radius-4:12px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--layout-navigation-divider-width:0.5px;--space-2:4px;--space-1:2px;--size-icon-button:var(--size-11);--gap-button-group:var(--space-3);--space-5:16px;--layout-main-detail-action-leading-padding:var(--space-5);--layout-main-title-leading-padding:var(--space-6);--space-6:24px;--gap-titlebar-brand:var(--space-4);--space-4:12px;--padding-titlebar-trailing-xl:var(--space-5);--height-titlebar-xl:var(--size-16);--size-16:72px;--padding-titlebar-trailing-l:var(--space-4);--height-titlebar-lg:var(--size-15);--size-15:64px;--padding-titlebar-trailing-m:var(--space-3);--height-titlebar-md:var(--size-14);--size-14:56px;--height-titlebar-sm:var(--size-11);--color-titlebar-normal-bg:transparent;--padding-titlebar-leading:var(--space-6);--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--color-icon-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--radius-icon-button:var(--radius-3);--radius-3:8px;--state-disabled-opacity:var(--opacity-40);--color-neutral-dark-15:#00000026;--color-text-muted:var(--color-neutral-dark-60);--radius-input:var(--radius-3);--color-input-focus-bg-on-default:var(--color-neutral-dark-05);--color-input-bg-on-default:var(--color-neutral-dark-05);--padding-search-x:var(--space-4);--height-input:var(--size-11);--state-layer-pressed:var(--color-neutral-dark-10);--color-button-ghost-hover-bg:var(--color-neutral-dark-05);--color-button-ghost-bg:transparent;--color-button-ghost-text:var(--color-brand-100);--letter-spacing-normal:0;--color-primary:var(--color-brand-100);--color-primary-text:var(--color-neutral-light-100);--radius-button:var(--radius-3);--padding-button-x:var(--space-5);--height-button:var(--size-11)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button { height: var(--height-button); padding: 0 var(--padding-button-x); display: inline-flex; align-items: center; justify-content: center; gap: var(--gap-button-icon-label); border: 0px; border-radius: var(--radius-button); color: var(--color-primary-text); background: var(--color-primary); cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--