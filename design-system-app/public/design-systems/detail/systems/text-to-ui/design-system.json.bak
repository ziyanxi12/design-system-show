       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--radius-full:999px;--color-brand-100:#0A59F7FF;--color-white:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--size-7:24px;--size-4:12px;--size-6:20px;--size-5:16px;--height-progress:var(--size-1);--size-1:4px;--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--space-3:8px}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-slider { --tui-slider-track-size: var(--height-progress); --tui-slider-thumb-size: var(--size-5); --tui-slider-track-radius: var(--radius-full); --tui-slider-thumb-fill: var(--color-brand-100); --tui-slider-thumb-offset: 0px; width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-3); color: var(--color-text); }\n.tui-slider--style-1 { --tui-slider-track-size: var(--height-progress); --tui-slider-thumb-size: var(--size-5); }\n.tui-slider--style-2 { --tui-slider-track-size: var(--size-6); --tui-slider-thumb-size: var(--size-4); --tui-slider-track-radius: var(--size-7); --tui-slider-thumb-fill: var(--color-white); --tui-slider-thumb-offset: -10px; }\n.tui-slider__control { min-width: 0px; width: 100%; height: max(var(--tui-slider-track-size), var(--tui-slider-thumb-size)); position: relative; }\n.tui-slider__track { position: absolute; z-index: 0; inset-inline: calc(var(--tui-slider-thumb-size) / 2); inset-block-start: 50%; height: var(--tui-slider-track-size); overflow: visible; transform: translateY(-50%); border-radius: var(--tui-slider-track-radius); background: var(--color-neutral-dark-05); pointer-events: none; }\n.tui-slider__fill { position: absolute; inset: 0px auto 0px 0px; width: var(--tui-slider-value, 84%); max-width: 100%; border-radius: var(--tui-slider-track-radius); background: var(--color-brand-100); pointer-events: none; }\n.tui-slider__thumb { position: absolute; z-index: 1; inset-block-start: 50%; inset-inline-start: calc(var(--tui-slider-value, 84%) + var(--tui-slider-thumb-offset)); width: var(--tui-slider-thumb-size); height: var(--tui-slider-thumb-size); transform: translate(-50%, -50%); border-radius: var(--radius-full); background: var(--tui-slider-thumb-fill); pointer-events: none; }\n.tui-slider input { min-width: 0px; width: 100%; height: 100%; position: absolute; z-index: 2; inset: 0px; margin: 0px; appearance: none; border: 0px; outline: 0px; background: transparent; cursor: pointer; opacity: 0; }\n.tui-slider output { min-width: 2ch; color: var(--color-text-muted); }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
