n[data-variant=\"primary\"][data-state=\"pressed\"] { background: linear-gradient(var(--state-layer-pressed), var(--state-layer-pressed)), var(--color-primary); }\n.tui-button[data-variant=\"secondary\"] { color: var(--color-brand-100); background: var(--color-button-secondary-bg); }\n.tui-button[data-variant=\"secondary\"][data-mode=\"icon-text\"], .tui-button[data-variant=\"secondary\"][data-mode=\"selection-dropdown\"] { color: var(--color-text); }\n.tui-button[data-variant=\"secondary\"]:hover:not(:disabled), .tui-button[data-variant=\"secondary\"][data-state=\"hover\"] { background: var(--color-button-secondary-hover-bg); }\n.tui-button[data-variant=\"danger\"] { color: var(--color-button-danger-text); background: var(--color-button-danger-bg); }\n.tui-button[data-variant=\"danger\"]:hover:not(:disabled), .tui-button[data-variant=\"danger\"][data-state=\"hover\"] { background: var(--color-button-danger-hover-bg); }\n.tui-button[data-variant=\"ghost\"] { color: var(--color-button-ghost-text); background: var(--color-button-ghost-bg); }\n.tui-button[data-mode=\"icon-text\"][data-variant=\"primary\"], .tui-button[data-mode=\"icon-text\"][data-variant=\"secondary\"] { gap: var(--gap-button-icon-label); padding-inline: var(--space-3); }\n.tui-button[data-mode=\"icon-text\"][data-variant=\"ghost\"] { color: var(--color-text); gap: var(--gap-button-icon-label); padding-inline: var(--space-3); }\n.tui-button[data-variant=\"ghost\"]:hover:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"hover\"] { background: var(--color-button-ghost-hover-bg); }\n.tui-button[data-variant=\"ghost\"]:active:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"pressed\"] { background: var(--state-layer-pressed); }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-button:disabled, .tui-button[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-button [data-slot=\"icon\"] { width: var(--icon-size-md); height: var(--icon-size-md); display: inline-grid; place-items: center; flex: 0 0 var(--icon-size-md); }\n.tui-button [data-slot=\"icon\"] svg { width: 100%; height: 100%; display: block; }\n.tui-button[data-size=\"small\"] { height: var(--height-button-sm); padding-inline: var(--padding-button-sm-x); font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-button--icon { width: var(--size-icon-button); min-width: var(--size-icon-button); max-width: var(--size-icon-button); height: var(--size-icon-button); min-height: var(--size-icon-button); max-height: var(--size-icon-button); flex: 0 0 var(--size-icon-button); padding: 0px; color: var(--color-icon); background: transparent; }\n.tui-button--icon[data-variant=\"ghost\"] { color: var(--color-icon); background: transparent; }\n.tui-button--icon:hover:not(:disabled) { background: var(--state-layer-hover); }\n.tui-button--icon:active:not(:disabled) { background: var(--state-layer-pressed); }\n.tui-button--icon [data-slot=\"icon\"] { width: var(--icon-size-md); height: var(--icon-size-md); }\n.tui-split-button__trigger > svg { width: 100%; height: 100%; display: block; transition: transform 0.16s; }\n.tui-button-dropdown, .tui-split-button { position: relative; width: max-content; }\n.tui-button-dropdown__menu { z-index: 20; min-width: 168px; padding: var(--padding-popup-menu); position: absolute; top: calc(100% + var(--space-2)); left: 0px; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface-raised); box-shadow: var(--shadow-2); }\n.tui-button-dropdown__menu[hidden] { display: none; }\n.tui-button-dropdown__item { width: 100%; height: var(--height-menu-item); padding: 0 var(--padding-menu-item-x); display: flex; align-items: center; border: 0px; border-radius: var(--radius-popup-menu-item); color: var(--color-text); background: transparent; cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); text-align: left; white-space: nowrap; }\n.tui-button-dropdown__item:hover, .tui-button-dropdown__item:focus-visible { background: var(--state-layer-hover); outline: 0px; }\n.tui-split-button__control { height: var(--height-dropdown-control); display: inline-flex; align-items: stretch; color: var(--color-icon-text-button-ghost-content); }\n.tui-split-button__main { height: var(--height-dropdown-control); gap: var(--space-2); padding-inline: var(--padding-split-button-main-x); border-radius: var(--radius-dropdown-button) 0 0 var(--radius-dropdown-button); color: inherit; background: var(--color-icon-text-button-ghost-bg); }\n.tui-split-button__main:hover:not(:disabled), .tui-split-button__trigger:hover:not(:disabled) { background: var(--color-icon-text-button-ghost-hover-bg); }\n.tui-split-button__main--icon { width: var(--size-icon-button); padding: 0px; }\n.tui-split-button__main [data-slot=\"icon\"] { width: var(--icon-size-md); height: var(--icon-size-md); }\n.tui-split-button__trigger { width: var(--width-split-button-trigger); height: var(--height-dropdown-control); padding: 0px; border-radius: 0 var(--radius-dropdown-button) var(--radius-dropdown-button) 0; color: inherit; background: var(--color-icon-text-button-ghost-bg); }\n.tui-split-button__trigger > svg { width: var(--icon-size-sm); height: var(--icon-size-sm); }\n.tui-split-button__control > .tui-button[data-variant=\"ghost\"] { color: var(--color-icon-text-button-ghost-content); background: var(--color-icon-text-button-ghost-bg); }\n.tui-split-button__control > .tui-button[data-variant=\"ghost\"]:hover:not(:disabled), .tui-split-button__control > .tui-button[data-variant=\"ghost\"][data-state=\"hover\"], .tui-split-button__control > .tui-button[data-variant=\"ghost\"][aria-expanded=\"true\"] { color: var(--color-icon-text-button-ghost-content); background: var(--color-icon-text-button-ghost-hover-bg); }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"16\"] [stroke] { stroke-width: 1; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
