lots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">状态 <i>state</i></div><div class=\"tp-row\"><div class=\"tp-it\"><label class=\"tui-component tui-label\" data-component=\"label\" data-renderer-key=\"label\" data-logical-component=\"Label/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" for=\"project-name\" data-typography-role=\"body-m\">邮箱</label><span class=\"tp-cap\">默认</span></div><div class=\"tp-it\"><label class=\"tui-component tui-label\" data-component=\"label\" data-renderer-key=\"label\" data-logical-component=\"Label/Default\" data-variant=\"default\" data-state=\"hover\" data-framework=\"html\" for=\"project-name\" data-typography-role=\"body-m\">邮箱</label><span class=\"tp-cap\">悬停</span></div><div class=\"tp-it\"><label class=\"tui-component tui-label\" data-component=\"label\" data-renderer-key=\"label\" data-logical-component=\"Label/Default\" data-variant=\"default\" data-state=\"focus\" data-framework=\"html\" for=\"project-name\" data-typography-role=\"body-m\">邮箱</label><span class=\"tp-cap\">聚焦</span></div><div class=\"tp-it\"><label class=\"tui-component tui-label\" data-component=\"label\" data-renderer-key=\"label\" data-logical-component=\"Label/Default\" data-variant=\"default\" data-state=\"disabled\" data-framework=\"html\" for=\"project-name\" data-typography-role=\"body-m\">邮箱</label><span class=\"tp-cap\">禁用</span></div></div></div></div>"
