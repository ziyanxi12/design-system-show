       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--state-layer-hover:var(--color-neutral-dark-05);--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-3:8px;--padding-menu-item-x:var(--space-4);--space-4:12px;--gap-menu-item-content:var(--space-3);--space-3:8px;--height-menu-item:var(--size-11);--size-11:40px;--shadow-2:0 0 20px 0 rgb(0 0 30 / 8%);--color-surface-raised:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--radius-card:var(--radius-4);--radius-4:12px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--padding-popup-menu:var(--space-2);--space-2:4px;--gap-menu-item:var(--space-1);--space-1:2px;--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--color-icon:var(--color-neutral-dark-90);--icon-size-sm:var(--size-5);--size-5:16px;--color-neutral-dark-20:#00000033;--color-surface-muted:var(--color-neutral-dark-05);--radius-tag:var(--radius-3);--height-tag:var(--size-8);--size-8:28px;--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--color-text-subtle:var(--color-neutral-dark-40);--color-neutral-dark-40:#00000066;--height-input:var(--size-11);--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--padding-search-x:var(--space-4);--color-input-bg-on-subtle:var(--color-white);--color-white:var(--color-neutral-light-100);--color-input-bg-on-default:var(--color-neutral-dark-05);--color-input-focus-bg-on-default:var(--color-neutral-dark-05);--color-input-hover-bg-on-default:var(--color-neutral-dark-10);--color-input-focus-bg-on-subtle:var(--color-white);--color-input-hover-border-on-subtle:var(--color-white);--color-input-hover-bg-on-subtle-layer:var(--color-neutral-dark-05);--radius-input:var(--radius-3)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-input, .tui-search { position: relative; width: 100%; min-width: 0px; height: var(--height-input); display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--padding-search-x); color: var(--color-text); border: 1px solid transparent; border-radius: var(--radius-input); background: var(--color-input-bg-on-default); font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-input[data-surface=\"gray\"], .tui-search[data-surface=\"gray\"] { background: var(--color-input-bg-on-subtle); }\n.tui-input[data-surface=\"gray\"]:hover { background: linear-gradient(var(--color-input-hover-bg-on-subtle-layer), var(--color-input-hover-bg-on-subtle-layer)), var(--color-input-bg-on-subtle); border: 2px solid var(--color-input-hover-border-on-subtle); padding-inline: 11px; }\n.tui-input[data-surface=\"gray\"]:focus-within { background: var(--color-input-focus-bg-on-subtle); }\n.tui-input:hover { background: var(--color-input-hover-bg-on-default); }\n.tui-input:focus-within { background: var(--color-input-focus-bg-on-default); }\n.tui-input--tag-entry:hover, .tui-input--tag-entry[data-state=\"hover\"] { background: var(--color-input-bg-on-default); border: 1px solid transparent; padding-inline: var(--padding-search-x); }\n.tui-input--tag-entry[data-surface=\"gray\"]:hover, .tui-input--tag-entry[data-surface=\"gray\"][data-state=\"hover\"] { background: var(--color-input-bg-on-subtle); border: 1px solid transparent; padding-inline: var(--padding-search-x); }\n.tui-input[data-state=\"disabled\"], .tui-search[data-state=\"disabled\"], .tui-input:has(input:disabled), .tui-search:has(input:disabled) { opacity: var(--state-disabled-opacity); }\n.tui-input input, .tui-search input { min-width: 0px; flex: 1 1 0%; padding: 0px; border: 0px; outline: 0px; color: inherit; background: transparent; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-input input::placeholder { color: var(--color-text-subtle); }\n.tui-input--tag-entry { height: auto; min-height: var(--height-input); align-items: center; gap: var(--space-4); padding-block: var(--space-2); }\n.tui-input-tag-entry__label { flex: 0 0 auto; color: var(--color-text-muted); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-input-tag-entry__editor { position: relative; min-width: 0px; min-height: var(--height-input); display: flex; flex: 1 1 auto; flex-wrap: wrap; align-items: center; gap: var(--space-2); border-bottom: 1px solid var(--color-border); }\n.tui-input--tag-entry:not([data-state=\"disabled\"]) .tui-input-tag-entry__editor:hover { border-bottom-color: var(--color-icon); }\n.tui-input-tag-entry__tags { min-width: 0px; display: flex; flex: 0 1 auto; flex-wrap: wrap; align-items: center; gap: var(--space-2); }\n.tui-input-tag-entry__input { width: auto; min-width: 5em; min-height: calc(var(--height-input) - 1px); flex: 1 1 8em !important; color: var(--color-text) !important; }\n.tui-input-tag-entry__input::placeholder { color: var(--color-text-subtle); }\n.tui-input-tag-entry__menu { max-height: 15rem; overflow-y: auto; }\n.tui-input-tag-entry__empty { min-height: var(--height-menu-item); display: flex; align-items: center; padding-inline: var(--padding-menu-item-x); color: var(--color-text-muted); font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); }\n.tui-input-tag-entry__empty[hidden] { display: none; }\n.tui-chip { min-height: var(--height-tag); display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4); border: 0px; border-radius: var(--radius-tag); color: var(--color-text); background: var(--color-surface-muted); }\n.tui-chip:not([aria-disabled=\"true\"]):hover { background: var(--color-neutral-dark-10); }\n.tui-chip:not([aria-disabled=\"true\"]):active { background: var(--color-neutral-dark-20); }\n.tui-chip__leading, .tui-chip__close { width: var(--icon-size-sm); height: var(--icon-size-sm); display: inline-grid; place-items: center; flex: 0 0 var(--icon-size-sm); }\n.tui-chip__leading:empty { display: none; }\n.tui-chip__leading > .tui-icon, .tui-chip__close > .tui-icon { width: var(--icon-size-sm); height: var(--icon-size-sm); }\n.tui-chip__label { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); white-space: nowrap; }\n.tui-chip__close { padding: 0px; color: var(--color-icon); cursor: pointer; background: transparent; border: 0px; }\n.tui-chip__close:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 1px; }\n.tui-chip__close:disabled { cursor: default; }\n.tui-advanced-menu__panel { z-index: 10; position: absolute; inset: calc(100% + var(--space-2)) 0 auto; display: grid; gap: var(--gap-menu-item); min-width: 220px; padding-block: var(--padding-popup-menu); padding-inline: var(--padding-popup-menu); border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface-raised); box-shadow: var(--shadow-2); }\n.tui-advanced-menu__panel[hidden], .tui-advanced-popover__panel[hidden], .tui-picker__panel[hidden] { display: none; }\n.tui-advanced-menu__item { min-height: var(--height-menu-item); display: flex; align-items: center; gap: var(--gap-menu-item-content); padding-inline: var(--padding-menu-item-x); border: 0px; border-radius: var(--radius-3); color: var(--color-text); background: transparent; text-align: start; font: inherit; cursor: pointer; }\n.tui-input-tag-entry__menu [role=\"option\"] { width: 100%; }\n.tui-advanced-menu__item:hover, .tui-advanced-menu__item:focus-visible { background: var(--state-layer-hover); outline: 0px; }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"16\"] [stroke] { stroke-width: 1; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] { padding: 16px; border-radius: 12px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.06) 0px 0px 0px 1px inset; }\n.tp [data-surface-context=\"gray\"] { background: var(--color-bg-subtle,#0000000C); box-shadow: none; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }\n.tp .tui-runtime-note { margin: 0px; font-size: 12px; line-height: 18px; color: rgb(138, 138, 138); }"
