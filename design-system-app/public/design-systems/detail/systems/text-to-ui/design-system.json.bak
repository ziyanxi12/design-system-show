       "path": "packages/components-html/src/index.js#renderRuntimeHtmlComponent(tabs)",
       "lang": "html",
       "code": "<style>body{display:block!important;padding:24px 28px!important;background:#fff}\n.tp{display:flex;flex-direction:column;gap:22px;font-family:var(--font-sans)}\n.tp-sec{display:flex;flex-direction:column;gap:10px;max-width:100%}\n.tp-l{font-size:12px;color:#8a8a8a}.tp-l i{font-style:normal;color:#b5b5b5;margin-left:4px}\n.tp-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp-it{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:64px;max-width:100%}\n.tp-cap{font-size:11px;color:#9a9a9a;line-height:14px;white-space:nowrap}\n.tp-it>*:first-child{max-width:100%}\n/* 规范仓库的组件示例集（renderRuntimeHtmlComponent）用到的外层排版类，仓库精简版里没有对应样式，这里补齐 */\n.tp :is(.tui-runtime-core-gallery,.tui-runtime-form-field-states,.tui-runtime-titlebar-gallery,.tui-feedback-specimens,.tui-list-card-group,.tui-runtime-titlebar-layouts){display:flex;flex-direction:column;gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-avatar-pair,.tui-runtime-structural-grid,.tui-runtime-surface-grid,.tui-runtime-state-grid,.tui-runtime-chips-gallery,.tui-badge-group,.tui-primary-navigation-items){display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp .tui-runtime-form-field-states{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-form-field-states)>[data-surface-context]{flex:1 1 280px;min-width:0}\n.tp :is(.tui-runtime-structural-cell,.tui-runtime-state-cell,.tui-feedback-specimen,.tui-runtime-avatar-pair>div,[data-surface-context]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}\n.tp [data-surface-context]{padding:16px;border-radius:12px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}\n.tp [data-surface-context=\"gray\"]{background:var(--color-bg-subtle,#0000000C);box-shadow:none}\n.tp [data-surface-context]>*:not(.tui-runtime-surface-label){width:100%}\n.tp :is(.tui-runtime-surface-label,.tui-runtime-titlebar-scenario-slots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">状态 <i>state</i></div><div class=\"tp-row\"><div class=\"tp-it\"><div class=\"tui-component tui-tabs\" data-component=\"tabs\" data-renderer-key=\"tabs\" data-logical-component=\"Tabs/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\"><div class=\"tui-tabs__list\" role=\"tablist\" aria-label=\"项目视图\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"is-selected\" data-tab=\"overview\" data-typography-role=\"body-l\">概览</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"projects\" data-typography-role=\"body-l\">项目</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"members\" data-typography-role=\"body-l\">成员</button></div><div class=\"tui-tabs__panel\" role=\"tabpanel\" data-tab-panel=\"overview\" data-typography-role=\"body-l\">工作空间概览</div></div><span class=\"tp-cap\">默认</span></div><div class=\"tp-it\"><div class=\"tui-component tui-tabs\" data-component=\"tabs\" data-renderer-key=\"tabs\" data-logical-component=\"Tabs/Default\" data-variant=\"default\" data-state=\"hover\" data-framework=\"html\"><div class=\"tui-tabs__list\" role=\"tablist\" aria-label=\"项目视图\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"is-selected\" data-tab=\"overview\" data-typography-role=\"body-l\">概览</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"projects\" data-typography-role=\"body-l\">项目</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"members\" data-typography-role=\"body-l\">成员</button></div><div class=\"tui-tabs__panel\" role=\"tabpanel\" data-tab-panel=\"overview\" data-typography-role=\"body-l\">工作空间概览</div></div><span class=\"tp-cap\">悬停</span></div><div class=\"tp-it\"><div class=\"tui-component tui-tabs\" data-component=\"tabs\" data-renderer-key=\"tabs\" data-logical-component=\"Tabs/Default\" data-variant=\"default\" data-state=\"focus\" data-framework=\"html\"><div class=\"tui-tabs__list\" role=\"tablist\" aria-label=\"项目视图\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"is-selected\" data-tab=\"overview\" data-typography-role=\"body-l\">概览</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"projects\" data-typography-role=\"body-l\">项目</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"members\" data-typography-role=\"body-l\">成员</button></div><div class=\"tui-tabs__panel\" role=\"tabpanel\" data-tab-panel=\"overview\" data-typography-role=\"body-l\">工作空间概览</div></div><span class=\"tp-cap\">聚焦</span></div><div class=\"tp-it\"><div class=\"tui-component tui-tabs\" data-component=\"tabs\" data-renderer-key=\"tabs\" data-logical-component=\"Tabs/Default\" data-variant=\"default\" data-state=\"disabled\" data-framework=\"html\"><div class=\"tui-tabs__list\" role=\"tablist\" aria-label=\"项目视图\"><button disabled type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"is-selected\" data-tab=\"overview\" data-typography-role=\"body-l\">概览</button><button disabled type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"projects\" data-typography-role=\"body-l\">项目</button><button disabled type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"members\" data-typography-role=\"body-l\">成员</button></div><div class=\"tui-tabs__panel\" role=\"tabpanel\" data-tab-panel=\"overview\" data-typography-role=\"body-l\">工作空间概览</div></div><span class=\"tp-cap\">禁用</span></div><div class=\"tp-it\"><div class=\"tui-component tui-tabs\" data-component=\"tabs\" data-renderer-key=\"tabs\" data-logical-component=\"Tabs/Default\" data-variant=\"default\" data-state=\"selected\" data-framework=\"html\"><div class=\"tui-tabs__list\" role=\"tablist\" aria-label=\"项目视图\"><button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"is-selected\" data-tab=\"overview\" data-typography-role=\"body-l\">概览</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"projects\" data-typography-role=\"body-l\">项目</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" data-tab=\"members\" data-typography-role=\"body-l\">成员</button></div><div class=\"tui-tabs__panel\" role=\"tabpanel\" data-tab-panel=\"overview\" data-typography-role=\"body-l\">工作空间概览</div></div><span class=\"tp-cap\">选中</span></div></div></div></div>"
