nderer-key=\"collapsible\" data-logical-component=\"Collapsible/Default\" data-variant=\"default\" data-state=\"hover\" data-framework=\"html\"><button class=\"tui-disclosure__trigger\" type=\"button\" aria-expanded=\"false\" aria-controls=\"collapsible-content\" data-typography-role=\"body-m\"><span data-slot=\"label\" data-typography-role=\"body-m\">更多信息</span><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"navigation/chevron-down\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><div class=\"tui-disclosure__content\" id=\"collapsible-content\" data-slot=\"content\" hidden data-typography-role=\"body-l\">点击展开查看详情</div></div><span class=\"tp-cap\">悬停</span></div><div class=\"tp-it\"><div class=\"tui-component tui-disclosure\" data-component=\"collapsible\" data-renderer-key=\"collapsible\" data-logical-component=\"Collapsible/Default\" data-variant=\"default\" data-state=\"focus\" data-framework=\"html\"><button class=\"tui-disclosure__trigger\" type=\"button\" aria-expanded=\"false\" aria-controls=\"collapsible-content\" data-typography-role=\"body-m\"><span data-slot=\"label\" data-typography-role=\"body-m\">更多信息</span><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"navigation/chevron-down\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><div class=\"tui-disclosure__content\" id=\"collapsible-content\" data-slot=\"content\" hidden data-typography-role=\"body-l\">点击展开查看详情</div></div><span class=\"tp-cap\">