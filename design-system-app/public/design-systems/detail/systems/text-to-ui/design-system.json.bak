      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-function-warning-100:#ED6F21FF;--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-title-s-weight:var(--font-weight-700);--font-weight-700:700;--type-title-s-leading:var(--line-height-24);--line-height-24:24px;--type-title-s-size:var(--font-size-20);--font-size-20:20px;--type-body-s-weight:var(--font-weight-400);--font-weight-400:400;--type-body-s-leading:var(--line-height-14);--line-height-14:14px;--type-body-s-size:var(--font-size-12);--font-size-12:12px;--type-body-m-weight:var(--font-weight-400);--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--color-neutral-dark-10:#00000019;--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-3:8px;--space-2:4px;--state-layer-hover:var(--color-neutral-dark-05);--radius-2:6px;--color-danger:var(--color-function-danger-100);--color-function-danger-100:#E84026FF;--radius-full:999px;--space-4:12px;--space-3:8px;--color-border:var(--color-neutral-dark-10);--color-surface:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--color-neutral-dark-100:#000000FF;--color-function-success-100:#64BB5CFF;--radius-5:16px}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-color-picker { box-sizing: border-box; width: min(100%, 360px); min-width: 320px; min-height: 515px; display: grid; align-content: start; gap: var(--space-2); padding: 14px 24px 24px; border: 0px; border-radius: var(--radius-5); color: var(--color-text); background: var(--color-surface); }\n.tui-color-picker *, .tui-color-picker ::before, .tui-color-picker ::after { box-sizing: border-box; }\n.tui-color-picker__title { margin: 0px; color: var(--color-text); font-size: var(--type-title-s-size); line-height: var(--type-title-s-leading); font-weight: var(--type-title-s-weight); }\n.tui-color-picker__tabs { min-height: 36px; display: inline-flex; align-items: center; gap: 0px; padding: 2px; border-radius: var(--radius-full); background: var(--color-neutral-dark-05); }\n.tui-color-picker__tab { min-height: 32px; flex: 1 1 auto; padding: 4px 16px; border: 0px; border-radius: var(--radius-full); color: var(--color-text-muted); background: transparent; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); white-space: nowrap; cursor: pointer; }\n.tui-color-picker__tab.is-selected { color: var(--color-text); background: var(--color-surface); }\n.tui-color-picker__tab:hover, .tui-color-picker__tab:focus-visible { color: var(--color-text); outline: 0px; }\n.tui-color-picker__mode { min-height: 28px; display: inline-flex; align-items: center; justify-content: flex-start; gap: var(--space-2); width: max-content; padding: 0px; border: 0px; color: var(--color-text); background: transparent; font: inherit; cursor: pointer; }\n.tui-color-picker__mode-icon { inline-size: 0px; block-size: 0px; border-inline: 4px solid transparent; border-block-start: 5px solid currentcolor; transform: translateY(2px); }\n.tui-color-picker__controls { display: grid; gap: var(--space-4); }\n.tui-color-picker__field { display: grid; gap: var(--space-2); }\n.tui-color-picker__field-label { color: var(--color-text); }\n.tui-color-picker__track-row { min-width: 0px; display: grid; grid-template-columns: minmax(0px, 1fr) 35px; align-items: center; gap: 12px; }\n.tui-color-picker__track { width: 100%; height: 24px; min-width: 0px; align-self: center; margin: 0px; appearance: none; border: 1px solid var(--color-border); border-radius: var(--radius-full); background: padding-box transparent; cursor: pointer; }\n.tui-color-picker__track::-webkit-slider-runnable-track { width: 100%; height: 24px; border: 0px; border-radius: var(--radius-full); background: var(--color-neutral-dark-10); }\n.tui-color-picker__track::-webkit-slider-thumb { width: 20px; height: 20px; margin-top: 2px; appearance: none; border: 2px solid var(--color-surface); border-radius: var(--radius-full); background: var(--color-surface); outline: 1px solid var(--color-neutral-dark-60); cursor: grab; }\n.tui-color-picker__field[data-axis=\"hue\"] .tui-color-picker__track::-webkit-slider-runnable-track { background: linear-gradient(90deg, var(--color-function-danger-100), var(--color-function-warning-100), var(--color-function-success-100), var(--color-brand-100), var(--color-function-danger-100)); }\n.tui-color-picker__field[data-axis=\"saturation\"] .tui-color-picker__track::-webkit-slider-runnable-track { background: linear-gradient(90deg, var(--color-surface), var(--color-function-danger-100)); }\n.tui-color-picker__field[data-axis=\"brightness\"] .tui-color-picker__track::-webkit-slider-runnable-track { background: linear-gradient(90deg, var(--color-neutral-dark-100), var(--color-function-danger-100)); }\n.tui-color-picker__field[data-axis=\"alpha\"] .tui-color-picker__track::-webkit-slider-runnable-track { background: linear-gradient(90deg, var(--color-surface), var(--color-function-danger-100)); }\n.tui-color-picker__value { min-width: 35px; padding: 4px 6px; border-radius: var(--radius-3); color: var(--color-text-muted); background: var(--color-neutral-dark-10); text-align: center; font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); }\n.tui-color-picker__divider { width: 100%; height: 1px; margin-block: var(--space-2); background: var(--color-border); }\n.tui-color-picker__summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }\n.tui-color-picker__summary-main { display: inline-flex; align-items: center; gap: var(--space-4); }\n.tui-color-picker__swatch { inline-size: 36px; block-size: 36px; flex: 0 0 36px; border-radius: var(--radius-full); background: var(--tui-color-picker-color, var(--color-danger)); }\n.tui-color-picker__eyedropper { inline-size: 28px; block-size: 28px; display: inline-grid; place-items: center; padding: 2px; border: 0px; border-radius: var(--radius-2); color: var(--color-text); background: transparent; cursor: pointer; }\n.tui-color-picker__eyedropper:hover, .tui-color-picker__eyedropper:focus-visible { background: var(--state-layer-hover); outline: 0px; }\n.tui-color-picker__eyedropper-icon { inline-size: 24px; block-size: 24px; display: block; }\n.tui-color-picker__hex { min-width: 0px; display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-text-muted); white-space: nowrap; }\n.tui-color-picker__hex-input { inline-size: 68px; min-height: 28px; padding: 4px 10px; border: 1px solid transparent; border-radius: var(--radius-3); color: var(--color-text); background: var(--color-neutral-dark-10); font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); text-transform: uppercase; }\n.tui-color-picker__hex-input:focus { border-color: var(--color-focus-ring); outline: 0px; }\n.tui-color-picker__favorites { display: grid; gap: var(--space-2); }\n.tui-color-picker__favorites-label { color: var(--color-text-muted); }\n.tui-color-picker__favorites-grid { display: grid; grid-template-columns: repeat(9, minmax(0px, 1fr)); gap: 5px 6px; }\n.tui-color-picker__favorite { inline-size: 30px; block-size: 30px; justify-self: center; padding: 0px; border: 0px; border-radius: var(--radius-3); color: var(--color-text); background: var(--tui-color-picker-swatch, var(--color-neutral-dark-10)); cursor: pointer; }\n.tui-color-picker__favorite:not(.tui-color-picker__favorite--add):nth-child(n+3) { background: var(--color-neutral-dark-10); }\n.tui-color-picker__favorite--add { display: grid; place-items: center; color: var(--color-text-muted); background: var(--color-neutral-dark-10); font-size: var(--type-title-s-size); line-height: 1; }\n.tui-color-picker__favorite:hover, .tui-color-picker__favorite:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 1px; }\n.tui-color-picker[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); }\n.tui-color-picker[data-state=\"disabled\"] button, .tui-color-picker[data-state=\"disabled\"] input { cursor: not-allowed; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-generated [data-typography-role=\"body-s\"], [data-typography-role=\"body-s\"] { font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); font-weight: var(--type-body-s-weight); }\n.tui-generated [data-typography-role=\"title-s\"], [data-typography-role=\"title-s\"] { font-size: var(--type-title-s-size); line-height: var(--type-title-s-leading); font-weight: var(--type-title-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
