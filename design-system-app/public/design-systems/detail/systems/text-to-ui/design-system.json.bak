      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--icon-size-lg:var(--size-7);--size-7:24px;--color-text-subtle:var(--color-neutral-dark-40);--color-neutral-dark-40:#00000066;--color-sidebar-selected-text:var(--color-brand-100);--color-brand-100:#0A59F7FF;--state-layer-pressed:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--color-sidebar-accent:var(--color-neutral-dark-05);--color-primary-level-unselected:var(--color-icon-subtle);--color-icon-subtle:var(--color-neutral-dark-40);--radius-icon-button:var(--radius-3);--radius-3:8px;--size-icon-button:var(--size-11);--size-11:40px;--color-focus-ring:var(--color-brand-100)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-primary-navigation-items { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 0px; }\n.tui-primary-navigation-item { width: var(--size-icon-button); min-width: var(--size-icon-button); height: var(--size-icon-button); min-height: var(--size-icon-button); padding: 0px; display: grid; place-items: center; flex: 0 0 var(--size-icon-button); border: 0px; border-radius: var(--radius-icon-button); color: var(--color-primary-level-unselected); background: transparent; cursor: pointer; }\n.tui-primary-navigation-item:hover:not(:disabled), .tui-primary-navigation-item[data-state=\"hover\"] { background: var(--color-sidebar-accent); }\n.tui-primary-navigation-item:active:not(:disabled), .tui-primary-navigation-item[data-state=\"pressed\"] { background: var(--state-layer-pressed); }\n.tui-primary-navigation-item[data-state=\"selected\"] { color: var(--color-sidebar-selected-text); background: transparent; }\n.tui-primary-navigation-item:disabled, .tui-primary-navigation-item[data-state=\"disabled\"] { color: var(--color-text-subtle); cursor: not-allowed; }\n.tui-primary-navigation-item [data-slot=\"icon\"] { width: var(--icon-size-lg); height: var(--icon-size-lg); display: grid; place-items: center; }\n.tui-primary-navigation-item [data-slot=\"icon\"] > svg { width: 100%; height: 100%; display: block; }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"24\"] [stroke] { stroke-width: 1.5; }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }\n.tp .tui-runtime-note { margin: 0px; font-size: 12px; line-height: 18px; color: rgb(138, 138, 138); }"
      }
     ]
    }
