ht: var(--icon-size-md); }\n.tui-input, .tui-search { position: relative; width: 100%; min-width: 0px; height: var(--height-input); display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--padding-search-x); color: var(--color-text); border: 1px solid transparent; border-radius: var(--radius-input); background: var(--color-input-bg-on-default); font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-search:has(.tui-search__scope) { gap: 0px; padding: 0px; border: 0px; }\n.tui-search:not([data-surface=\"gray\"]) { background: var(--color-input-bg-on-default); }\n.tui-search:not(:has(.tui-search__scope)):hover:not([data-state=\"disabled\"]) { background: var(--color-neutral-dark-05); }\n.tui-search:not(:has(.tui-search__scope)):focus-within { background: var(--color-input-focus-bg-on-default); }\n.tui-search__input-region { min-width: 0px; height: 100%; display: flex; align-items: center; gap: var(--space-3); flex: 1 1 auto; padding-inline-start: 0px; border-radius: var(--radius-1); background: transparent; }\n.tui-search:has(.tui-search__scope) > .tui-search__input-region { padding-inline: var(--space-3) var(--space-2); border-radius: 0 var(--radius-input) var(--radius-input) 0; }\n.tui-search:not(:has(.tui-search__scope)) > .tui-search__input-region { border-radius: var(--radius-input); }\n.tui-search [data-slot=\"leading\"] { width: var(--icon-size-sm); height: var(--icon-size-sm); display: inline-grid; place-items: center; flex: 0 0 var(--icon-size-sm); color: var(--color-icon-muted); }\n.tui-search [data-slot=\"leading\"] svg { width: 100%; height: 100%; display: block; }\n.tui-search [data-slot=\"clear\"] { width: var(--icon-size-sm); height: var(--icon-size-sm); flex: 0 0 var(--icon-size-sm); color: var(--color-icon); }\n.tui-search [data-slot=\"clear\"]:hover:not(:disabled) { color: var(--color-icon); background: transparent; }\n.tui-search [dat