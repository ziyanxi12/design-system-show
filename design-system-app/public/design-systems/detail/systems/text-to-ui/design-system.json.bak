       "lang": "html",
       "code": "<style>body{display:block!important;padding:24px 28px!important;background:#fff}\n.tp{display:flex;flex-direction:column;gap:22px;font-family:var(--font-sans)}\n.tp-sec{display:flex;flex-direction:column;gap:10px;max-width:100%}\n.tp-l{font-size:12px;color:#8a8a8a}.tp-l i{font-style:normal;color:#b5b5b5;margin-left:4px}\n.tp-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp-it{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:64px;max-width:100%}\n.tp-cap{font-size:11px;color:#9a9a9a;line-height:14px;white-space:nowrap}\n.tp-it>*:first-child{max-width:100%}\n/* 规范仓库的组件示例集（renderRuntimeHtmlComponent）用到的外层排版类，仓库精简版里没有对应样式，这里补齐 */\n.tp :is(.tui-runtime-core-gallery,.tui-runtime-form-field-states,.tui-runtime-titlebar-gallery,.tui-feedback-specimens,.tui-list-card-group,.tui-runtime-titlebar-layouts){display:flex;flex-direction:column;gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-avatar-pair,.tui-runtime-structural-grid,.tui-runtime-surface-grid,.tui-runtime-state-grid,.tui-runtime-chips-gallery,.tui-badge-group,.tui-primary-navigation-items){display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp .tui-runtime-form-field-states{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-form-field-states)>[data-surface-context]{flex:1 1 280px;min-width:0}\n.tp :is(.tui-runtime-structural-cell,.tui-runtime-state-cell,.tui-feedback-specimen,.tui-runtime-avatar-pair>div,[data-surface-context]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}\n.tp [data-surface-context]{padding:16px;border-radius:12px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}\n.tp [data-surface-context=\"gray\"]{background:var(--color-bg-subtle,#0000000C);box-shadow:none}\n.tp [data-surface-context]>*:not(.tui-runtime-surface-label){width:100%}\n.tp :is(.tui-runtime-surface-label,.tui-runtime-titlebar-scenario-slots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">规范示例 <i>specimens</i></div><div class=\"tui-feedback-specimens\" data-runtime-component=\"snackbar\"><div class=\"tui-feedback-specimen\" data-specimen=\"title-only\"><span class=\"tui-runtime-surface-label\">Title</span><div class=\"tui-component tui-snackbar\" data-component=\"snackbar\" data-renderer-key=\"snackbar\" data-logical-component=\"Snackbar/Default\" data-variant=\"title-only\" data-state=\"default\" data-framework=\"html\" data-left-area=\"1\" role=\"status\"><span class=\"tui-snackbar__main\"><span class=\"tui-snackbar__leading\" data-slot=\"leading\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" data-icon-alias=\"status/info\" data-icon-size=\"24\" data-display-size-token=\"size/24\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 16v-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 8h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-snackbar__content\"><span class=\"tui-snackbar__title\" data-slot=\"title\" data-typography-role=\"subtitle-s\">Title</span></span></span><span class=\"tui-snackbar__actions\"><span class=\"tui-snackbar__action-slot\" data-slot=\"action\"><button class=\"tui-button tui-button--ghost tui-snackbar__action\" type=\"button\" data-variant=\"ghost\" data-size=\"small\" data-typography-role=\"body-m\">文本按钮</button></span><button class=\"tui-icon-button tui-snackbar__close\" data-slot=\"close\" type=\"button\" aria-label=\"关闭\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"action/close\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m6 6 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></span></div></div><div class=\"tui-feedback-specimen\" data-specimen=\"title-subtitle\"><span class=\"tui-runtime-surface-label\">Title + Subtitle</span><div class=\"tui-component tui-snackbar\" data-component=\"snackbar\" data-renderer-key=\"snackbar\" data-logical-component=\"Snackbar/Default\" data-variant=\"title-subtitle\" data-state=\"default\" data-framework=\"html\" data-left-area=\"2\" role=\"status\"><span class=\"tui-snackbar__main\"><span class=\"tui-snackbar__leading\" data-slot=\"leading\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" data-icon-alias=\"status/info\" data-icon-size=\"24\" data-display-size-token=\"size/24\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 16v-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 8h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-snackbar__content\"><span class=\"tui-snackbar__title\" data-slot=\"title\" data-typography-role=\"subtitle-s\">Title</span><span class=\"tui-snackbar__subtitle\" data-slot=\"subtitle\" data-typography-role=\"body-s\">Subtitle</span></span></span><span class=\"tui-snackbar__actions\"><span class=\"tui-snackbar__action-slot\" data-slot=\"action\"><button class=\"tui-button tui-button--ghost tui-snackbar__action\" type=\"button\" data-variant=\"ghost\" data-size=\"small\" data-typography-role=\"body-m\">文本按钮</button></span><button class=\"tui-icon-button tui-snackbar__close\" data-slot=\"close\" type=\"button\" aria-label=\"关闭\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"action/close\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m6 6 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></span></div></div></div></div></div>"
