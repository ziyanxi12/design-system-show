      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--state-layer-hover:var(--color-neutral-dark-05);--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-3:8px;--padding-menu-item-x:var(--space-4);--space-4:12px;--gap-menu-item-content:var(--space-3);--space-3:8px;--height-menu-item:var(--size-11);--size-11:40px;--shadow-2:0 0 20px 0 rgb(0 0 30 / 8%);--color-surface-raised:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--radius-card:var(--radius-4);--radius-4:12px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--padding-popup-menu:var(--space-2);--space-2:4px;--gap-menu-item:var(--space-1);--space-1:2px;--color-input-bg-on-default:var(--color-neutral-dark-05);--radius-input:var(--radius-3);--padding-select-x:var(--space-4);--height-input:var(--size-11);--gap-field-label:var(--space-3);--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--color-icon-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--radius-icon-button:var(--radius-3);--size-icon-button:var(--size-11);--icon-size-sm:var(--size-5);--size-5:16px;--color-text-muted:var(--color-neutral-dark-60);--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--color-input-hover-border-on-subtle:var(--color-white);--color-white:var(--color-neutral-light-100);--color-neutral-dark-15:#00000026;--color-input-hover-bg-on-subtle-layer:var(--color-neutral-dark-05);--color-icon:var(--color-neutral-dark-90);--size-6:20px;--space-5:16px;--radius-1:4px;--color-input-focus-bg-on-subtle:var(--color-white);--color-input-focus-bg-on-default:var(--color-neutral-dark-05);--color-input-bg-on-subtle:var(--color-white);--padding-search-x:var(--space-4);--padding-button-sm-x:var(--space-3);--height-button-sm:var(--size-8);--size-8:28px;--state-layer-pressed:var(--color-neutral-dark-10);--color-button-ghost-hover-bg:var(--color-neutral-dark-05);--color-button-ghost-bg:transparent;--color-button-ghost-text:var(--color-brand-100);--letter-spacing-normal:0;--color-primary:var(--color-brand-100);--color-primary-text:var(--color-neutral-light-100);--radius-button:var(--radius-3);--gap-button-icon-label:var(--space-3);--padding-button-x:var(--space-5);--height-button:var(--size-11)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button { height: var(--height-button); padding: 0 var(--padding-button-x); display: inline-flex; align-items: center; justify-content: center; gap: var(--gap-button-icon-label); border: 0px; border-radius: var(--radius-button); color: var(--color-primary-text); background: var(--color-primary); cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); letter-spacing: var(--letter-spacing-normal); white-space: nowrap; }\n.tui-button[data-variant=\"ghost\"] { color: var(--color-button-ghost-text); background: var(--color-button-ghost-bg); }\n.tui-button[data-variant=\"ghost\"]:hover:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"hover\"] { background: var(--color-button-ghost-hover-bg); }\n.tui-button[data-variant=\"ghost\"]:active:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"pressed\"] { background: var(--state-layer-pressed); }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-button:disabled, .tui-button[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-button[data-size=\"small\"] { height: var(--height-button-sm); padding-inline: var(--padding-button-sm-x); font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-input, .tui-search { position: relative; width: 100%; min-width: 0px; height: var(--height-input); display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--padding-search-x); color: var(--color-text); border: 1px solid transparent; border-radius: var(--radius-input); background: var(--color-input-bg-on-default); font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-input[data-surface=\"gray\"], .tui-search[data-surface=\"gray\"] { background: var(--color-input-bg-on-subtle); }\n.tui-search:has(.tui-search__scope) { gap: 0px; padding: 0px; border: 0px; }\n.tui-search[data-surface=\"gray\"] { background: var(--color-input-bg-on-subtle); }\n.tui-search:not([data-surface=\"gray\"]) { background: var(--color-input-bg-on-default); }\n.tui-search:not(:has(.tui-search__scope)):hover:not([data-state=\"disabled\"]) { background: var(--color-neutral-dark-05); }\n.tui-search[data-surface=\"gray\"]:not(:has(.tui-search__scope)):hover:not([data-state=\"disabled\"]) { background: linear-gradient(var(--color-input-hover-bg-on-subtle-layer), var(--color-input-hover-bg-on-subtle-layer)), var(--color-input-bg-on-subtle); }\n.tui-search:not(:has(.tui-search__scope)):focus-within { background: var(--color-input-focus-bg-on-default); }\n.tui-search[data-surface=\"gray\"]:not(:has(.tui-search__scope)):focus-within { background: var(--color-input-focus-bg-on-subtle); }\n.tui-search__input-region { min-width: 0px; height: 100%; display: flex; align-items: center; gap: var(--space-3); flex: 1 1 auto; padding-inline-start: 0px; border-radius: var(--radius-1); background: transparent; }\n.tui-search:has(.tui-search__scope) > .tui-search__input-region { padding-inline: var(--space-3) var(--space-2); border-radius: 0 var(--radius-input) var(--radius-input) 0; }\n.tui-search:not(:has(.tui-search__scope)) > .tui-search__input-region { border-radius: var(--radius-input); }\n.tui-search__scope.tui-advanced-menu { width: 73px; min-width: 73px; height: 100%; position: relative; display: inline-flex; align-items: center; flex: 0 0 73px; gap: 0px; padding: 0 0 0 var(--space-4); border-radius: var(--radius-input) 0 0 var(--radius-input); background: transparent; }\n.tui-search__scope.tui-advanced-menu::after { content: \"\"; width: 1px; height: var(--space-5); position: absolute; inset-inline-end: 0px; top: 50%; transform: translateY(-50%); background: var(--color-border); }\n.tui-search__scope .tui-advanced-menu__label { display: none; }\n.tui-search__scope .tui-advanced-menu__trigger { min-width: 56px; width: 56px; min-height: 100%; display: inline-flex; align-items: center; justify-content: flex-start; gap: var(--space-2); padding: 0px; border: 0px; border-radius: 0px; color: var(--color-text); background: transparent; font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-search__scope .tui-advanced-menu__trigger:hover { background: transparent; }\n.tui-search__scope .tui-advanced-menu__trigger:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: -2px; }\n.tui-search__scope .tui-advanced-menu__trigger > .tui-icon:last-child { margin: 0px; width: var(--size-6); height: var(--size-6); color: var(--color-icon); }\n.tui-search__scope .tui-advanced-menu__panel { min-wi