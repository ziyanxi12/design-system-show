       "code": "<style>body{display:block!important;padding:24px 28px!important;background:#fff}\n.tp{display:flex;flex-direction:column;gap:22px;font-family:var(--font-sans)}\n.tp-sec{display:flex;flex-direction:column;gap:10px;max-width:100%}\n.tp-l{font-size:12px;color:#8a8a8a}.tp-l i{font-style:normal;color:#b5b5b5;margin-left:4px}\n.tp-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp-it{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:64px;max-width:100%}\n.tp-cap{font-size:11px;color:#9a9a9a;line-height:14px;white-space:nowrap}\n.tp-it>*:first-child{max-width:100%}\n/* 规范仓库的组件示例集（renderRuntimeHtmlComponent）用到的外层排版类，仓库精简版里没有对应样式，这里补齐 */\n.tp :is(.tui-runtime-core-gallery,.tui-runtime-form-field-states,.tui-runtime-titlebar-gallery,.tui-feedback-specimens,.tui-list-card-group,.tui-runtime-titlebar-layouts){display:flex;flex-direction:column;gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-avatar-pair,.tui-runtime-structural-grid,.tui-runtime-surface-grid,.tui-runtime-state-grid,.tui-runtime-chips-gallery,.tui-badge-group,.tui-primary-navigation-items){display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp .tui-runtime-form-field-states{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-form-field-states)>[data-surface-context]{flex:1 1 280px;min-width:0}\n.tp :is(.tui-runtime-structural-cell,.tui-runtime-state-cell,.tui-feedback-specimen,.tui-runtime-avatar-pair>div,[data-surface-context]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}\n.tp [data-surface-context]{padding:16px;border-radius:12px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}\n.tp [data-surface-context=\"gray\"]{background:var(--color-bg-subtle,#0000000C);box-shadow:none}\n.tp [data-surface-context]>*:not(.tui-runtime-surface-label){width:100%}\n.tp :is(.tui-runtime-surface-label,.tui-runtime-titlebar-scenario-slots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">规范示例 <i>specimens</i></div><div class=\"tui-runtime-form-field-states\"><div data-surface-context=\"white\"><span class=\"tui-runtime-surface-label\">默认 · 白色内容面 / 灰色输入面</span><section class=\"tui-component tui-form-field\" data-component=\"form-field\" data-renderer-key=\"form-field\" data-logical-component=\"Form Field/Default\" data-variant=\"input\" data-state=\"default\" data-framework=\"html\" data-surface=\"white\" data-required=\"false\"><span data-slot=\"label\" data-typography-role=\"subtitle-s\">项目名称</span><div class=\"tui-form-field__control\" data-slot=\"control\"><label class=\"tui-component tui-input\" data-component=\"input\" data-renderer-key=\"input\" data-logical-component=\"Input/White Surface/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-surface=\"white\"><input data-slot=\"value\" data-typography-role=\"body-l\" type=\"text\" value=\"客户端设计系统\" aria-label=\"项目名称\"/></label></div></section></div><div data-surface-context=\"gray\"><span class=\"tui-runtime-surface-label\">默认 · 灰色内容面 / 白色输入面</span><section class=\"tui-component tui-form-field\" data-component=\"form-field\" data-renderer-key=\"form-field\" data-logical-component=\"Form Field/Default\" data-variant=\"input\" data-state=\"default\" data-framework=\"html\" data-surface=\"gray\" data-required=\"false\"><span data-slot=\"label\" data-typography-role=\"subtitle-s\">项目名称</span><div class=\"tui-form-field__control\" data-slot=\"control\"><label class=\"tui-component tui-input\" data-component=\"input\" data-renderer-key=\"input\" data-logical-component=\"Input/White Surface/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-surface=\"gray\"><input data-slot=\"value\" data-typography-role=\"body-l\" type=\"text\" value=\"客户端设计系统\" aria-label=\"项目名称\"/></label></div></section></div><div data-surface-context=\"white\"><span class=\"tui-runtime-surface-label\">必填 · 白色内容面 / 灰色选择面</span><section class=\"tui-component tui-form-field\" data-component=\"form-field\" data-renderer-key=\"form-field\" data-logical-component=\"Form Field/Default\" data-variant=\"select\" data-state=\"default\" data-framework=\"html\" data-surface=\"white\" data-required=\"true\"><span data-slot=\"label\" data-typography-role=\"subtitle-s\"><span class=\"tui-form-field__required\" aria-hidden=\"true\">*</span>项目状态</span><div class=\"tui-form-field__control\" data-slot=\"control\"><div class=\"tui-component tui-select tui-form-field__select\" data-component=\"select\" data-renderer-key=\"select\" data-logical-component=\"Select/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-surface=\"white\"><button class=\"tui-select__trigger\" type=\"button\" aria-label=\"项目状态\" aria-haspopup=\"listbox\" aria-expanded=\"false\"><span data-slot=\"value\" data-typography-role=\"body-m\">进行中</span><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" data-icon-alias=\"navigation/chevron-down\" data-icon-size=\"16\" data-display-size-token=\"size/16\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><div class=\"tui-select__menu\" role=\"listbox\" aria-label=\"项目状态\" hidden><button type=\"button\" role=\"option\" aria-selected=\"true\" data-typography-role=\"body-l\">进行中</button><button type=\"button\" role=\"option\" aria-selected=\"false\" data-typography-role=\"body-l\">已完成</button></div></div></div></section></div><div data-surface-context=\"gray\"><span class=\"tui-runtime-surface-label\">必填 · 灰色内容面 / 白色选择面</span><section class=\"tui-component tui-form-field\" data-component=\"form-field\" data-renderer-key=\"form-field\" data-logical-component=\"Form Field/Default\" data-variant=\"select\" data-state=\"default\" data-framework=\"html\" data-surface=\"gray\" data-required=\"true\"><span data-slot=\"label\" data-typography-role=\"subtitle-s\"><span class=\"tui-form-field__required\" aria-hidden=\"true\">*</span>项目状态</span><div class=\"tui-form-field__control\" data-slot=\"control\"><div class=\"tui-component tui-select tui-form-field__select\" data-component=\"select\" data-renderer-key=\"select\" data-logical-component=\"Select/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-surface=\"gray\"><button class=\"tui-select__trigger\" type=\"button\" aria-label=\"项目状态\" aria-haspopup=\"listbox\" aria-expanded=\"false\"><span data-slot=\"value\" data-typography-role=\"body-m\">进行中</span><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" data-icon-alias=\"navigation/chevron-down\" data-icon-size=\"16\" data-display-size-token=\"size/16\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><div class=\"tui-select__menu\" role=\"listbox\" aria-label=\"项目状态\" hidden><button type=\"button\" role=\"option\" aria-selected=\"true\" data-typography-role=\"body-l\">进行中</button><button type=\"button\" role=\"option\" aria-selected=\"false\" data-typography-role=\"body-l\">已完成</button></div></div></div></section></div><div data-surface-context=\"white\"><span class=\"tui-runtime-surface-label\">错误 · 白色内容面 / 灰色输入面</span><section class=\"tui-component tui-form-field\" data-component=\"form-field\" data-renderer-key=\"form-field\" data-logical-component=\"Form Field/Default\" data-variant=\"input\" data-state=\"error\" data-framework=\"html\" data-surface=\"white\" data-required=\"false\"><span data-slot=\"label\" data-typography-role=\"subtitle-s\">项目名称</span><div class=\"tui-form-field__control\" data-slot=\"control\"><label class=\"tui-component tui-input\" data-component=\"input\" data-renderer-key=\"input\" data-logical-component=\"Input/White Surface/Default\" data-variant=\"default\" data-state=\"error\" data-framework=\"html\" data-surface=\"white\"><input data-slot=\"value\" data-typography-role=\"body-l\" type=\"text\" value=\"\" aria-label=\"项目名称\" aria-invalid=\"true\"/></label></div><span class=\"tui-form-field__error\" data-slot=\"error\" role=\"alert\" data-typography-role=\"body-s\">项目名称不能为空</span></section></div><div data-surface-context=\"gray\"><span class=\"tui-runtime-surface-label\">错误 · 灰色内容面 / 白色输入面</span><section class=\"tui-component tui-form-field\" data-component=\"form-field\" data-renderer-key=\"form-field\" data-logical-component=\"Form Field/Default\" data-variant=\"input\" data-state=\"error\" data-framework=\"html\" data-surface=\"gray\" data-required=\"false\"><span data-slot=\"label\" data-typography-role=\"subtitle-s\">项目名称</span><div class=\"tui-form-field__control\" data-slot=\"control\"><label class=\"tui-component tui-input\" data-component=\"input\" data-renderer-key=\"input\" data-logical-component=\"Input/White Surface/Default\" data-variant=\"default\" data-state=\"error\" data-framework=\"html\" data-surface=\"gray\"><input data-slot=\"value\" data-typography-role=\"body-l\" type=\"text\" value=\"\" aria-label=\"项目名称\" aria-invalid=\"true\"/></label></div><span class=\"tui-form-field__error\" data-slot=\"error\" role=\"alert\" data-typography-role=\"body-s\">项目名称不能为空</span></section></div></div></div></div>"
