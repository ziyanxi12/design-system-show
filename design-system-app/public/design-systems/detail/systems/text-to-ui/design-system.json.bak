ill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M14 2v5a1 1 0 0 0 1 1h5\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-tree-view__label\" data-slot=\"label\" data-typography-role=\"body-l\">组件库</span></button></li></ul></li><li class=\"tui-tree-view__node\" data-node-id=\"members\"><button disabled type=\"button\" role=\"treeitem\" class=\"tui-tree-view__item\" data-tree-toggle=\"false\" data-node-id=\"members\" style=\"--tree-indent:12px\" aria-level=\"2\" aria-selected=\"false\"><span class=\"tui-tree-view__chevron\" aria-hidden=\"true\"></span><span class=\"tui-tree-view__icon\" data-slot=\"leading\" aria-hidden=\"true\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"object/file\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M14 2v5a1 1 0 0 0 1 1h5\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-tree-view__label\" data-slot=\"label\" data-typography-role=\"body-l\">成员</span><span class=\"tui-tree-view__trailing\" data-slot=\"trailing\" data-typography-role=\"body-m\">8</span></button></li></ul></li><li class=\"tui-tree-view__node\" data-node-id=\"archive\"><button disabled type=\"button\" role=\"treeitem\" class=\"tui-tree-view__item\" data-tree-toggle=\"false\" data-node-id=\"archive\" style=\"--tree-indent:0px\" aria-level=\"1\" aria-selected=\"false\"><span class=\"tui-tree-view__chevron\" aria-hidden=\"true\"></span><span class=\"tui-tree-view__icon\" data-slot=\"leading\" aria-hidden=\"