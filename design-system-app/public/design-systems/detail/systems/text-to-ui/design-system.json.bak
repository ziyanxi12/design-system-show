       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--switch-height:var(--size-6);--size-6:20px;--switch-width:var(--size-11);--size-11:40px;--color-primary:var(--color-brand-100);--color-surface:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--radius-full:999px;--color-neutral-dark-20:#00000033;--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--radius-list-item:var(--radius-3);--radius-3:8px;--space-3:8px;--gap-choice-label:var(--space-3);--height-list-item:var(--size-11);--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-choice { min-width: 0px; color: var(--color-text); font-family: var(--font-sans); }\n.tui-choice input { position: absolute; inline-size: 1px; block-size: 1px; opacity: 0; pointer-events: none; }\n.tui-checkbox, .tui-switch { min-height: var(--height-list-item); display: grid; grid-template-columns: auto minmax(0px, 1fr) auto; align-items: center; gap: var(--gap-choice-label); padding: var(--space-3); border-radius: var(--radius-list-item); cursor: pointer; }\n.tui-checkbox [data-slot=\"description\"], .tui-switch [data-slot=\"description\"] { color: var(--color-text-muted); font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); }\n.tui-switch__track { width: var(--switch-width); height: var(--switch-height); position: relative; box-sizing: border-box; display: block; flex: 0 0 var(--switch-width); border-radius: var(--radius-full); background: var(--color-neutral-dark-20); transition: background 0.18s; }\n.tui-switch__track::after { content: \"\"; position: absolute; inset-block-start: 2px; inset-inline-start: 2px; width: calc(var(--switch-height) - 4px); height: calc(var(--switch-height) - 4px); border-radius: var(--radius-full); background: var(--color-surface); transition: transform 0.18s; }\n.tui-switch input:checked + .tui-switch__track { background: var(--color-primary); }\n.tui-switch input:checked + .tui-switch__track::after { transform: translateX(calc(var(--switch-width) - var(--switch-height))); }\n.tui-choice input:focus-visible + .tui-checkbox__indicator, .tui-choice input:focus-visible + .tui-radio__indicator, .tui-choice input:focus-visible + .tui-switch__track { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
      }
