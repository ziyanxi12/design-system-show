lots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">状态 <i>state</i></div><div class=\"tp-row\"><div class=\"tp-it\"><section class=\"tui-component tui-color-picker\" data-component=\"color-picker\" data-renderer-key=\"color-picker\" data-logical-component=\"ColorPicker/Tablet\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-color-value=\"FA2A2F\" aria-label=\"颜色编辑器\"><h3 class=\"tui-color-picker__title\" data-slot=\"title\" data-typography-role=\"title-s\">Color Editor</h3><div class=\"tui-color-picker__tabs\" role=\"tablist\" aria-label=\"颜色模式\"><button type=\"button\" class=\"tui-color-picker__tab is-selected\" role=\"tab\" aria-selected=\"true\" data-color-picker-tab=\"color-card\">Color card</button><button type=\"button\" class=\"tui-color-picker__tab\" role=\"tab\" aria-selected=\"false\" data-color-picker-tab=\"slider\">Slider</button><button type=\"button\" class=\"tui-color-picker__tab\" role=\"tab\" aria-selected=\"false\" data-color-picker-tab=\"color-disc\">Color disc</button></div><button type=\"button\" class=\"tui-color-picker__mode\" data-color-picker-mode aria-label=\"颜色模式：HSB\"><span data-slot=\"mode\" data-typography-role=\"body-l\">HSB</span><span class=\"tui-color-picker__mode-icon\" aria-hidden=\"true\"></span></button><div class=\"tui-color-picker__controls\"><label class=\"tui-color-picker__field\" data-axis=\"hue\"><span class=\"tui-color-picker__field-label\" data-typography-role=\"body-m\">Hue</span><spa