ht-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-primary:var(--color-brand-100);--color-primary-text:var(--color-neutral-light-100);--radius-button:var(--radius-3);--gap-button-icon-label:var(--space-3);--padding-button-x:var(--space-5);--space-5:16px;--height-button:var(--size-11)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button { height: var(--height-button); padding: 0 var(--padding-button-x); display: inline-flex; align-items: center; justify-content: center; gap: var(--gap-button-icon-label); border: 0px; border-radius: var(--radius-button); color: var(--color-primary-text); background: var(--color-primary); cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); letter-spacing: var(--letter-spacing-normal); white-space: nowrap; }\n.tui-button[data-variant=\"ghost\"] { color: var(--color-button-ghost-text); background: var(--color-button-ghost-bg); }\n.tui-button[data-variant=\"ghost\"]:hover:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"hover\"] { background: var(--color-button-ghost-hover-bg); }\n.tui-button[data-variant=\"ghost\"]:active:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"pressed\"] { background: var(--state-layer-pressed); }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-button:disabled, .tui-button[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-button[data-size=\"small\"] { height: var(--height-button-sm); padding-inline: var(--padding-button-sm-x); font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-icon-button svg { width: var(--icon-size-sm); height: var(--icon-size-sm); display: block; }\n.tui-icon-button { width: var(--size-icon-button); height: var(--size-icon-button); padding: 0px; display: inline-grid; place-items: center; border: 0px; border-radius: var(--radius-icon-button); color: var(--color-icon-muted); background: transparent; cursor: pointer; }\n.tui-icon-button:hover { color: var(--color-text); background: var(--state-layer-hover); }\n.tui-icon-button:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 1px; }\n.tui-snackbar { min-width: 328px; max-width: 400px; height: var(--height-snackbar); display: flex; align-items: center; gap: var(--space-2); padding: 0 var(--space-2) 0 var(--space-4); border-radius: var(--radius-5); color: var(--color-text); background: var(--color-surface); box-shadow: var(--shadow-1); backdrop-filter: blur(26.667px); }\n.tui-snackbar__main { min-width: 0px; display: flex; align-items: center; gap: var(--space-4); flex: 1 1 auto; }\n.tui-snackbar__leading { width: var(--icon-size-lg); height: var(--icon-size-lg); display: inline-grid; place-items: center; flex: 0 0 var(--icon-size-lg); color: var(--color-text); }\n.tui-snackbar__leading > .tui-icon { width: var(--icon-size-lg); height: var(--icon-size-lg); }\n.tui-snackbar__content { min-width: 0px; display: flex; flex: 1 1 auto; flex-direction: column; justify-content: center; gap: var(--space-1); }\n.tui-snackbar__title { min-width: 0px; overflow: hidden; color: var(--color-text); font-size: var(--type-subtitle-s-size); line-height: var(--type-subtitle-s-leading); font-weight: var(--type-subtitle-s-weight); text-overflow: ellipsis; white-space: nowrap; }\n.tui-snackbar__subtitle { min-width: 0px; overflow: hidden; color: var(--color-text); font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); font-weight: var(--type-body-s-weight); text-overflow: ellipsis; white-space: nowrap; }\n.tui-snackbar__actions { display: inline-flex; align-items: center; flex: 0 0 auto; }\n.tui-snackbar__action-slot { display: inline-flex; align-items: center; }\n.tui-snackbar__action { min-height: 28px; }\n.tui-snackbar__close { width: 40px; height: 40px; color: var(--color-icon); }\n.tui-snackbar__close > .tui-icon { width: var(--icon-size-md); height: var(--icon-size-md); }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-icon--regular[data-icon-size=\"24\"] [stroke] { stroke-width: 1.5; }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-generated [data-typography-role=\"body-s\"], [data-typography-role=\"body-s\"] { font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); font-weight: var(--type-body-s-weight); }\n.tui-generated [data-typography-role=\"subtitle-s\"], [data-typography-role=\"subtitle-s\"] { font-size: var(--type-subtitle-s-size); line-height: var(--type-subtitle-s-leading); font-weight: var(--type-subtitle-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, 