       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--color-input-focus-bg-on-default:var(--color-neutral-dark-05);--color-input-hover-bg-on-default:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--icon-size-sm:var(--size-5);--size-5:16px;--padding-select-x:var(--space-4);--space-4:12px;--color-input-bg-on-default:var(--color-neutral-dark-05);--radius-input:var(--radius-3);--radius-3:8px;--gap-menu-item-content:var(--space-3);--space-3:8px;--height-input:var(--size-11);--size-11:40px;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--padding-textarea-x:var(--space-4);--gap-field-label:var(--space-3)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-textarea, .tui-field, .tui-native-select { width: 100%; display: grid; gap: var(--gap-field-label); color: var(--color-text); font-family: var(--font-sans); }\n.tui-textarea > [data-slot=\"label\"], .tui-field > [data-slot=\"label\"], .tui-native-select > [data-slot=\"label\"] { color: var(--color-text); }\n.tui-textarea > textarea, .tui-field__control, .tui-native-select__control { min-width: 0px; width: 100%; min-height: var(--height-input); display: flex; align-items: center; gap: var(--gap-menu-item-content); padding: 0 var(--padding-textarea-x); border: 1px solid transparent; border-radius: var(--radius-input); color: var(--color-text); background: var(--color-input-bg-on-default); font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-textarea > textarea:hover, .tui-field__control:hover, .tui-native-select__control:hover { background: var(--color-input-hover-bg-on-default); }\n.tui-textarea > textarea:focus, .tui-field__control:focus-within, .tui-native-select__control:focus-within { background: var(--color-input-focus-bg-on-default); outline: 0px; }\n.tui-textarea[data-state=\"disabled\"], .tui-field[data-state=\"disabled\"], .tui-native-select[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); }\n.tui-field__control input, .tui-native-select__control select { min-width: 0px; flex: 1 1 0%; border: 0px; outline: 0px; color: inherit; background: transparent; font: inherit; }\n.tui-native-select__control { position: relative; min-width: max-content; padding: 0px; border: 0px; overflow: hidden; background: transparent; }\n.tui-native-select__control select { appearance: none; position: relative; width: 100%; height: var(--height-input); min-width: max-content; padding: 0 calc(var(--padding-select-x) + var(--icon-size-sm) + var(--gap-menu-item-content)) 0 var(--padding-select-x); border: 1px solid transparent; border-radius: var(--radius-input); background: var(--color-input-bg-on-default); cursor: pointer; }\n.tui-native-select__control > .tui-icon { position: absolute; inset-inline-end: var(--padding-select-x); top: 50%; transform: translateY(-50%); width: var(--icon-size-sm); height: var(--icon-size-sm); pointer-events: none; }\n.tui-native-select__control:hover, .tui-native-select__control:focus-within { background: transparent; }\n.tui-native-select__control select:hover { background: var(--color-input-hover-bg-on-default); }\n.tui-native-select__control select:focus { background: var(--color-input-focus-bg-on-default); outline: 0px; }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"16\"] [stroke] { stroke-width: 1; }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
