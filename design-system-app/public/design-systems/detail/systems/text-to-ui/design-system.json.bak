       "path": "packages/components-html/src/index.js#renderRuntimeHtmlComponent(semi-modal)",
       "lang": "html",
       "code": "<style>body{display:block!important;padding:24px 28px!important;background:#fff}\n.tp{display:flex;flex-direction:column;gap:22px;font-family:var(--font-sans)}\n.tp-sec{display:flex;flex-direction:column;gap:10px;max-width:100%}\n.tp-l{font-size:12px;color:#8a8a8a}.tp-l i{font-style:normal;color:#b5b5b5;margin-left:4px}\n.tp-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp-it{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:64px;max-width:100%}\n.tp-cap{font-size:11px;color:#9a9a9a;line-height:14px;white-space:nowrap}\n.tp-it>*:first-child{max-width:100%}\n/* 规范仓库的组件示例集（renderRuntimeHtmlComponent）用到的外层排版类，仓库精简版里没有对应样式，这里补齐 */\n.tp :is(.tui-runtime-core-gallery,.tui-runtime-form-field-states,.tui-runtime-titlebar-gallery,.tui-feedback-specimens,.tui-list-card-group,.tui-runtime-titlebar-layouts){display:flex;flex-direction:column;gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-avatar-pair,.tui-runtime-structural-grid,.tui-runtime-surface-grid,.tui-runtime-state-grid,.tui-runtime-chips-gallery,.tui-badge-group,.tui-primary-navigation-items){display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp .tui-runtime-form-field-states{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-form-field-states)>[data-surface-context]{flex:1 1 280px;min-width:0}\n.tp :is(.tui-runtime-structural-cell,.tui-runtime-state-cell,.tui-feedback-specimen,.tui-runtime-avatar-pair>div,[data-surface-context]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}\n.tp [data-surface-context]{padding:16px;border-radius:12px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}\n.tp [data-surface-context=\"gray\"]{background:var(--color-bg-subtle,#0000000C);box-shadow:none}\n.tp [data-surface-context]>*:not(.tui-runtime-surface-label){width:100%}\n.tp :is(.tui-runtime-surface-label,.tui-runtime-titlebar-scenario-slots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">变体 <i>variant</i></div><div class=\"tp-row\"><div class=\"tp-it\"><div class=\"tui-overlay-example\" data-overlay-example=\"semi-modal\"><div class=\"tui-specimen-controls\" aria-label=\"半模态结构维度\"><label data-typography-role=\"body-m\">尺寸<select data-semi-axis=\"size\" onchange=\"const l=this.closest('[data-overlay-example]').querySelector('[data-overlay-id=semi-modal]');l.dataset.size=this.value;const d=l.querySelector('.tui-dialog');d.dataset.variant=l.dataset.size+'-'+l.dataset.surface+'-'+l.dataset.mode;d.setAttribute('aria-modal',String(l.dataset.mode==='modal'))\"><option value=\"s\">S · 480</option><option value=\"m\" selected>M · 640</option><option value=\"l\">L · 800</option></select></label><label data-typography-role=\"body-m\">背景<select data-semi-axis=\"surface\" onchange=\"const l=this.closest('[data-overlay-example]').querySelector('[data-overlay-id=semi-modal]');l.dataset.surface=this.value;const d=l.querySelector('.tui-dialog');d.dataset.variant=l.dataset.size+'-'+l.dataset.surface+'-'+l.dataset.mode;d.setAttribute('aria-modal',String(l.dataset.mode==='modal'))\"><option value=\"white\" selected>White</option><option value=\"gray\">Gray</option></select></label><label data-typography-role=\"body-m\">模式<select data-semi-axis=\"mode\" onchange=\"const l=this.closest('[data-overlay-example]').querySelector('[data-overlay-id=semi-modal]');l.dataset.mode=this.value;const d=l.querySelector('.tui-dialog');d.dataset.variant=l.dataset.size+'-'+l.dataset.surface+'-'+l.dataset.mode;d.setAttribute('aria-modal',String(l.dataset.mode==='modal'))\"><option value=\"non-modal\" selected>Non-modal</option><option value=\"modal\">Modal</option></select></label></div><button class=\"tui-button\" type=\"button\" data-variant=\"secondary\" data-overlay-trigger=\"semi-modal\" data-typography-role=\"body-l\" onclick=\"const l=this.nextElementSibling;l.hidden=false;const d=l.querySelector('.tui-dialog');d.dataset.state='open';d.focus()\">打开半模态弹窗</button><div class=\"tui-overlay-layer\" id=\"semi-modal\" data-overlay-id=\"semi-modal\" data-size=\"m\" data-surface=\"white\" data-mode=\"non-modal\" hidden><div class=\"tui-overlay-backdrop\" aria-hidden=\"true\"></div><section class=\"tui-component tui-dialog tui-dialog--semi\" data-component=\"semi-modal\" data-renderer-key=\"semi-modal\" data-logical-component=\"Semi-modal/Default\" data-variant=\"s\" data-state=\"open\" data-framework=\"html\" role=\"dialog\" aria-modal=\"false\" aria-labelledby=\"semi-modal-title\" aria-describedby=\"semi-modal-description\" tabindex=\"-1\" onkeydown=\"if(event.key==='Escape'){event.preventDefault();const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()}\"><header class=\"tui-dialog__header\"><h4 id=\"semi-modal-title\" data-typography-role=\"title-s\">编辑项目设置</h4><button class=\"tui-icon-button tui-dialog__close\" type=\"button\" data-overlay-close aria-label=\"关闭\" onclick=\"const e=this.closest('[data-overlay-example]');this.closest('.tui-overlay-layer').hidden=true;e.querySelector('[data-overlay-trigger]').focus()\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"action/close\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=