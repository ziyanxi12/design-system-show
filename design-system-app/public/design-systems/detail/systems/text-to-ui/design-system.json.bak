      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-title-s-weight:var(--font-weight-700);--font-weight-700:700;--type-title-s-leading:var(--line-height-24);--line-height-24:24px;--type-title-s-size:var(--font-size-20);--font-size-20:20px;--type-body-s-weight:var(--font-weight-400);--font-weight-400:400;--type-body-s-leading:var(--line-height-14);--line-height-14:14px;--type-body-s-size:var(--font-size-12);--font-size-12:12px;--type-body-m-weight:var(--font-weight-400);--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--state-layer-hover:var(--color-neutral-dark-05);--color-badge-neutral-text:var(--color-text-muted);--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--height-table-header:var(--size-11);--size-11:40px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--space-3:8px;--height-table-row:var(--size-13);--size-13:48px;--space-4:12px;--color-surface:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-table:var(--radius-4);--radius-4:12px;--layout-main-detail-padding-x:var(--space-6);--space-6:24px;--color-badge-success-bg:var(--color-function-success-10);--color-function-success-10:#64BB5C19;--color-badge-success-text:var(--color-function-success-100);--color-function-success-100:#64BB5CFF;--color-badge-info-bg:var(--color-brand-10);--color-brand-10:#0A59F719;--color-badge-info-text:var(--color-info);--color-info:var(--color-brand-100);--color-brand-100:#0A59F7FF;--radius-1:4px;--padding-tag-x:var(--space-4);--height-tag:var(--size-8);--size-8:28px}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-badge { min-height: var(--height-tag); display: inline-flex; align-items: center; width: max-content; padding-inline: var(--padding-tag-x); border-radius: var(--radius-1); font-family: var(--font-sans); }\n.tui-badge--info { color: var(--color-badge-info-text); background: var(--color-badge-info-bg); }\n.tui-badge--success { color: var(--color-badge-success-text); background: var(--color-badge-success-bg); }\n.tui-table { min-width: 0px; display: grid; gap: var(--space-4); padding-inline: var(--layout-main-detail-padding-x); padding-block: 0px; border: 1px solid var(--color-border); border-radius: var(--radius-table); color: var(--color-text); background: var(--color-surface); overflow-x: auto; }\n.tui-table__heading { min-height: var(--height-table-header); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }\n.tui-table__heading h4 { margin: 0px; }\n.tui-table__heading > span { color: var(--color-text-muted); }\n.tui-table table { min-width: 520px; width: 100%; border-collapse: collapse; }\n.tui-table th, .tui-table td { height: var(--height-table-row); padding-inline: var(--space-3); border-bottom: 1px solid var(--color-border); text-align: start; }\n.tui-table th { height: var(--height-table-header); color: var(--color-badge-neutral-text); }\n.tui-table tbody tr:hover { background: var(--state-layer-hover); }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type