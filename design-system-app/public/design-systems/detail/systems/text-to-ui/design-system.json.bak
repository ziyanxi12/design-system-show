       "lang": "html",
       "code": "<style>body{display:block!important;padding:24px 28px!important;background:#fff}\n.tp{display:flex;flex-direction:column;gap:22px;font-family:var(--font-sans)}\n.tp-sec{display:flex;flex-direction:column;gap:10px;max-width:100%}\n.tp-l{font-size:12px;color:#8a8a8a}.tp-l i{font-style:normal;color:#b5b5b5;margin-left:4px}\n.tp-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp-it{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:64px;max-width:100%}\n.tp-cap{font-size:11px;color:#9a9a9a;line-height:14px;white-space:nowrap}\n.tp-it>*:first-child{max-width:100%}\n/* 规范仓库的组件示例集（renderRuntimeHtmlComponent）用到的外层排版类，仓库精简版里没有对应样式，这里补齐 */\n.tp :is(.tui-runtime-core-gallery,.tui-runtime-form-field-states,.tui-runtime-titlebar-gallery,.tui-feedback-specimens,.tui-list-card-group,.tui-runtime-titlebar-layouts){display:flex;flex-direction:column;gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-avatar-pair,.tui-runtime-structural-grid,.tui-runtime-surface-grid,.tui-runtime-state-grid,.tui-runtime-chips-gallery,.tui-badge-group,.tui-primary-navigation-items){display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp .tui-runtime-form-field-states{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-form-field-states)>[data-surface-context]{flex:1 1 280px;min-width:0}\n.tp :is(.tui-runtime-structural-cell,.tui-runtime-state-cell,.tui-feedback-specimen,.tui-runtime-avatar-pair>div,[data-surface-context]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}\n.tp [data-surface-context]{padding:16px;border-radius:12px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}\n.tp [data-surface-context=\"gray\"]{background:var(--color-bg-subtle,#0000000C);box-shadow:none}\n.tp [data-surface-context]>*:not(.tui-runtime-surface-label){width:100%}\n.tp :is(.tui-runtime-surface-label,.tui-runtime-titlebar-scenario-slots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">规范示例 <i>specimens</i></div><div class=\"tui-feedback-specimens\" data-runtime-component=\"alert\"><div class=\"tui-feedback-specimen\" data-specimen=\"info\"><span class=\"tui-runtime-surface-label\">Info / 信息</span><div class=\"tui-component tui-alert tui-alert--info\" data-component=\"alert\" data-renderer-key=\"alert\" data-logical-component=\"Alert/Default\" data-variant=\"info\" data-state=\"default\" data-framework=\"html\" role=\"status\"><span class=\"tui-alert__icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"status/info\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 16v-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 8h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-alert__message\" data-slot=\"content\" data-typography-role=\"subtitle-s\">系统将在今晚自动完成更新。</span><span class=\"tui-alert__actions\" data-slot=\"actions\"><button class=\"tui-button tui-button--ghost tui-alert__action\" type=\"button\" data-slot=\"action\" data-variant=\"ghost\" data-mode=\"text\" data-size=\"small\" data-button-type=\"small-ghost\" data-typography-role=\"body-m\">查看详情</button><button class=\"tui-icon-button\" data-slot=\"close\" type=\"button\" aria-label=\"关闭\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"action/close\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m6 6 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></span></div></div><div class=\"tui-feedback-specimen\" data-specimen=\"success\"><span class=\"tui-runtime-surface-label\">Success / 成功</span><div class=\"tui-component tui-alert tui-alert--success\" data-component=\"alert\" data-renderer-key=\"alert\" data-logical-component=\"Alert/Default\" data-variant=\"success\" data-state=\"default\" data-framework=\"html\" role=\"status\"><span class=\"tui-alert__icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"status/success\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m9 12 2 2 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-alert__message\" data-slot=\"content\" data-typography-role=\"subtitle-s\">所有修改已经同步到云端。</span><span class=\"tui-alert__actions\" data-slot=\"actions\"><button class=\"tui-button tui-button--ghost tui-alert__action\" type=\"button\" data-slot=\"action\" data-variant=\"ghost\" data-mode=\"text\" data-size=\"small\" data-button-type=\"small-ghost\" data-typography-role=\"body-m\">查看详情</button><button class=\"tui-icon-button\" data-slot=\"close\" type=\"button\" aria-label=\"关闭\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"action/close\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m6 6 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></span></div></div><div class=\"tui-feedback-specimen\" data-specimen=\"warning\"><span class=\"tui-runtime-surface-label\">Warning / 警告</span><div class=\"tui-component tui-alert tui-alert--warning\" data-component=\"alert\" data-renderer-key=\"alert\" data-logical-component=\"Alert/Default\" data-variant=\"warning\" data-state=\"default\" data-framework=\"html\" role=\"alert\"><span class=\"tui-alert__icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"status/warning\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-alert__message\" data-slot=\"content\" data-typography-role=\"subtitle-s\">连接不稳定，部分内容可能暂时无法加载。</span><span class=\"tui-alert__actions\" data-slot=\"actions\"><button class=\"tui-button tui-button--ghost tui-alert__action\" type=\"button\" data-slot=\"action\" data-variant=\"ghost\" data-mode=\"text\" data-size=\"small\" data-button-type=\"small-ghost\" data-typography-role=\"body-m\">重新连接</button><button class=\"tui-icon-button\" data-slot=\"close\" type=\"button\" aria-label=\"关闭\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"action/close\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m6 6 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></span></div></div><div class=\"tui-feedback-specimen\" data-specimen=\"danger\"><span class=\"tui-runtime-surface-label\">Danger / 危险</span><div class=\"tui-component tui-alert tui-alert--danger\" data-component=\"alert\" data-renderer-key=\"alert\" data-logical-component=\"Alert/Default\" data-variant=\"danger\" data-state=\"default\" data-framework=\"html\" role=\"alert\"><span class=\"tui-alert__icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"status/danger\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m15 9-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m9 9 6 6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-alert__message\" data-slot=\"content\" data-typography-role=\"subtitle-s\">存储空间不足，请清理空间后重试。</span><span class=\"tui-alert__actions\" data-slot=\"actions\"><button class=\"tui-button tui-button--ghost tui-alert__action\" type=\"button\" data-slot=\"action\" data-variant=\"ghost\" data-mode=\"text\" data-size=\"small\" data-button-type=\"small-ghost\" data-typography-role=\"body-m\">清理空间</button><button class=\"tui-icon-button\" data-slot=\"close\" type=\"button\" aria-label=\"关闭\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"action/close\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m6 6 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></span></div></div><div class=\"tui-feedback-specimen\" data-specimen=\"neutral\"><span class=\"tui-runtime-surface-label\">Neutral / 中性</span><div class=\"tui-component tui-alert tui-alert--neutral\" data-component=\"alert\" data-renderer-key=\"alert\" data-logical-component=\"Alert/Default\" data-variant=\"neutral\" data-state=\"default\" data-framework=\"html\" role=\"status\"><span class=\"tui-alert__icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"status/neutral\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M8 12h8\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span><span class=\"tui-alert__message\" data-slot=\"content\" data-typography-role=\"subtitle-s\">当前为只读模式，部分编辑操作暂不可用。</span><span class=\"tui-alert__actions\" data-slot=\"actions\"><button class=\"tui-button tui-button--ghost tui-alert__action\" type=\"button\" data-slot=\"action\" data-variant=\"ghost\" data-mode=\"text\" data-size=\"small\" data-button-type=\"small-ghost\" data-typography-role=\"body-m\">知道了</button><button class=\"tui-icon-button\" data-slot=\"close\" type=\"button\" aria-label=\"关闭\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" data-icon-alias=\"action/close\" data-icon-size=\"20\" data-display-size-token=\"size/20\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M18 6 6 18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m6 6 12 12\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></span></div></div></div></div></div>"
      },
      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-subtitle-s-weight:var(--font-weight-500);--font-weight-500:500;--type-subtitle-s-leading:var(--line-height-16);--line-height-16:16px;--type-subtitle-s-size:var(--font-size-14);--font-size-14:14px;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--type-body-m-size:var(--font-size-14);--icon-size-md:var(--size-6);--size-6:20px;--color-icon:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--space-1:2px;--color-text:var(--color-neutral-dark-90);--color-alert-neutral-subtle:var(--color-neutral-dark-05);--color-alert-neutral:var(--color-text-muted);--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--color-danger-subtle:var(--color-function-danger-10);--color-function-danger-10:#E8402619;--color-danger:var(--color-function-danger-100);--color-function-danger-100:#E84026FF;--color-warning-subtle:var(--color-function-warning-10);--color-function-warning-10:#ED6F2119;--color-warning:var(--color-function-warning-100);--color-function-warning-100:#ED6F21FF;--color-success-subtle:var(--color-function-success-10);--color-function-success-10:#64BB5C19;--color-success:var(--color-function-success-100);--color-function-success-100:#64BB5CFF;--color-info-subtle:var(--color-brand-10);--color-brand-10:#0A59F719;--color-info:var(--color-brand-100);--color-brand-100:#0A59F7FF;--radius-alert:var(--radius-3);--radius-3:8px;--padding-alert-left:var(--space-3);--space-3:8px;--padding-alert-right:var(--space-2);--space-2:4px;--gap-alert-content:var(--space-3);--height-alert:var(--size-11);--size-11:40px;--color-focus-ring:var(--color-brand-100);--state-layer-hover:var(--color-neutral-dark-05);--color-icon-muted:var(--color-neutral-dark-60);--radius-icon-button:var(--radius-3);--size-icon-button:var(--size-11);--icon-size-sm:var(--size-5);--size-5:16px;--padding-button-sm-x:var(--space-3);--height-button-sm:var(--size-8);--size-8:28px;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--state-layer-pressed:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--color-button-ghost-hover-bg:var(--color-neutral-dark-05);--color-button-ghost-bg:transparent;--color-button-ghost-text:var(--color-brand-100);--letter-spacing-normal:0;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-primary:var(--color-brand-100);--color-primary-text:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--radius-button:var(--radius-3);--gap-button-icon-label:var(--space-3);--padding-button-x:var(--space-5);--space-5:16px;--height-button:var(--size-11)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button { height: var(--height-button); padding: 0 var(--padding-button-x); display: inline-flex; align-items: center; justify-content: center; gap: var(--gap-button-icon-label); border: 0px; border-radius: var(--radius-button); color: var(--color-primary-text); background: var(--color-primary); cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); letter-spacing: var(--letter-spacing-normal); white-space: nowrap; }\n.tui-button[data-variant=\"ghost\"] { color: var(--color-button-ghost-text); background: var(--color-button-ghost-bg); }\n.tui-button[data-variant=\"ghost\"]:hover:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"hover\"] { background: var(--color-button-ghost-hover-bg); }\n.tui-button[data-variant=\"ghost\"]:active:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"pressed\"] { background: var(--state-layer-pressed); }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-button:disabled, .tui-button[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-button[data-size=\"small\"] { height: var(--height-button-sm); padding-inline: var(--padding-button-sm-x); font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-icon-button svg { width: var(--icon-size-sm); height: var(--icon-size-sm); display: block; }\n.tui-icon-button { width: var(--size-icon-button); height: var(--size-icon-button); padding: 0px; display: inline-grid; place-items: center; border: 0px; border-radius: var(--radius-icon-button); color: var(--color-icon-muted); background: transparent; cursor: pointer; }\n.tui-icon-button:hover { color: var(--color-text); background: var(--state-layer-hover); }\n.tui-icon-button:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 1px; }\n.tui-alert { min-height: var(--height-alert); display: flex; align-items: center; gap: var(--gap-alert-content); padding: 0 var(--padding-alert-right) 0 var(--padding-alert-left); border-radius: var(--radius-alert); color: var(--color-info); background: var(--color-info-subtle); }\n.tui-alert--success { color: var(--color-success); background: var(--color-success-subtle); }\n.tui-alert--warning { color: var(--color-warning); background: var(--color-warning-subtle); }\n.tui-alert--danger { color: var(--color-danger); background: var(--color-danger-subtle); }\n.tui-alert--neutral { color: var(--color-alert-neutral); background: var(--color-alert-neutral-subtle); }\n.tui-alert__icon, .tui-toast__icon { width: var(--icon-size-md); height: var(--icon-size-md); flex: 0 0 var(--icon-size-md); display: inline-grid; place-items: center; line-height: 0; }\n.tui-alert__icon > .tui-icon, .tui-toast__icon > .tui-icon { width: var(--icon-size-md); height: var(--icon-size-md); display: block; }\n.tui-alert__message { color: var(--color-text); font-size: var(--type-subtitle-s-size); line-height: var(--type-subtitle-s-leading); font-weight: var(--type-subtitle-s-weight); }\n.tui-alert__actions { height: 100%; display: inline-flex; align-items: center; gap: var(--space-1); flex: 0 0 auto; margin-inline-start: auto; }\n.tui-alert__action { margin-inline-start: 0px; }\n.tui-alert__action[data-size=\"small\"] { flex: 0 0 auto; }\n.tui-alert .tui-icon-button, .tui-toast .tui-icon-button { display: inline-grid; place-items: center; line-height: 0; color: var(--color-icon); }\n.tui-alert .tui-icon-button { width: 32px; height: 32px; margin-inline-start: 0px; }\n.tui-alert .tui-icon-button > .tui-icon { width: var(--icon-size-md); height: var(--icon-size-md); }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-generated [data-typography-role=\"subtitle-s\"], [data-typography-role=\"subtitle-s\"] { font-size: var(--type-subtitle-s-size); line-height: var(--type-subtitle-s-leading); font-weight: var(--type-subtitle-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
      }
     ]
    }
   },
   {
    "id": "snackbar",
    "name": "Snackbar",
    "desc": "展示类 · Snackbar/Default",
    "props": [
     {
      "name": "variant",
      "values": "title-only | title-subtitle"
     }
