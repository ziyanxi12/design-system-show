       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-l-weight:var(--font-weight-400);--font-weight-400:400;--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--shadow-1:0 0 4px 0 rgb(0 0 30 / 15%);--color-tooltip-bg:var(--color-surface);--color-surface:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--color-tooltip-text:var(--color-text);--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-tooltip:var(--radius-2);--radius-2:6px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--padding-tooltip:var(--space-3);--space-3:8px;--space-2:4px;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--state-layer-pressed:var(--color-neutral-dark-10);--color-button-ghost-hover-bg:var(--color-neutral-dark-05);--color-button-ghost-bg:transparent;--color-button-ghost-text:var(--color-brand-100);--letter-spacing-normal:0;--color-primary:var(--color-brand-100);--color-primary-text:var(--color-neutral-light-100);--radius-button:var(--radius-3);--radius-3:8px;--gap-button-icon-label:var(--space-3);--padding-button-x:var(--space-5);--space-5:16px;--height-button:var(--size-11);--size-11:40px}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button { height: var(--height-button); padding: 0 var(--padding-button-x); display: inline-flex; align-items: center; justify-content: center; gap: var(--gap-button-icon-label); border: 0px; border-radius: var(--radius-button); color: var(--color-primary-text); background: var(--color-primary); cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); letter-spacing: var(--letter-spacing-normal); white-space: nowrap; }\n.tui-button[data-variant=\"ghost\"] { color: var(--color-button-ghost-text); background: var(--color-button-ghost-bg); }\n.tui-button[data-variant=\"ghost\"]:hover:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"hover\"] { background: var(--color-button-ghost-hover-bg); }\n.tui-button[data-variant=\"ghost\"]:active:not(:disabled), .tui-button[data-variant=\"ghost\"][data-state=\"pressed\"] { background: var(--state-layer-pressed); }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-button:disabled, .tui-button[data-state=\"disabled\"] { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-tooltip { position: relative; width: max-content; display: inline-flex; }\n.tui-tooltip__panel { z-index: 10; position: absolute; left: 50%; bottom: calc(100% + var(--space-2)); transform: translateX(-50%); min-width: max-content; padding: var(--padding-tooltip); border: 1px solid var(--color-border); border-radius: var(--radius-tooltip); color: var(--color-tooltip-text); background: var(--color-tooltip-bg); box-shadow: var(--shadow-1); opacity: 0; pointer-events: none; transition: opacity 0.12s; }\n.tui-tooltip:hover .tui-tooltip__panel, .tui-tooltip:focus-within .tui-tooltip__panel, .tui-tooltip[data-open=\"true\"] .tui-tooltip__panel { opacity: 1; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
