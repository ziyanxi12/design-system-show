      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-subtitle-s-weight:var(--font-weight-500);--font-weight-500:500;--type-subtitle-s-leading:var(--line-height-16);--line-height-16:16px;--type-subtitle-s-size:var(--font-size-14);--font-size-14:14px;--type-body-s-weight:var(--font-weight-400);--font-weight-400:400;--type-body-s-leading:var(--line-height-14);--line-height-14:14px;--type-body-s-size:var(--font-size-12);--font-size-12:12px;--type-body-m-weight:var(--font-weight-400);--type-body-m-leading:var(--line-height-16);--type-body-m-size:var(--font-size-14);--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--state-layer-hover:var(--color-neutral-dark-05);--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-popup-menu-item:var(--radius-1);--radius-1:4px;--padding-menu-item-x:var(--space-4);--space-4:12px;--height-menu-item:var(--size-11);--size-11:40px;--color-surface-raised:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--radius-card:var(--radius-4);--radius-4:12px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--padding-popup-menu:var(--space-2);--space-2:4px;--gap-menu-item:var(--space-1);--space-1:2px;--icon-size-sm:var(--size-5);--size-5:16px;--color-input-focus-bg-on-subtle:var(--color-white);--color-white:var(--color-neutral-light-100);--color-input-bg-on-subtle:var(--color-white);--color-input-hover-bg-on-subtle-layer:var(--color-neutral-dark-05);--color-input-hover-border-on-subtle:var(--color-white);--padding-select-x:var(--space-4);--color-input-focus-bg-on-default:var(--color-neutral-dark-05);--color-input-hover-bg-on-default:var(--color-neutral-dark-10);--color-input-bg-on-default:var(--color-neutral-dark-05);--radius-input:var(--radius-3);--radius-3:8px;--gap-menu-item-content:var(--space-3);--space-3:8px;--height-input:var(--size-11);--gap-field-label:var(--space-3);--color-alert:var(--color-function-danger-100);--color-function-danger-100:#E84026FF;--color-text-subtle:var(--color-neutral-dark-40);--color-neutral-dark-40:#00000066;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--color-input-error-border:var(--color-function-danger-100);--padding-search-x:var(--space-4)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-input, .tui-search { position: relative; width: 100%; min-width: 0px; height: var(--height-input); display: flex; align-items: center; gap: var(--space-3); padding: 0 var(--padding-search-x); color: var(--color-text); border: 1px solid transparent; border-radius: var(--radius-input); background: var(--color-input-bg-on-default); font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-input[data-surface=\"gray\"], .tui-search[data-surface=\"gray\"] { background: var(--color-input-bg-on-subtle); }\n.tui-input[data-surface=\"gray\"]:hover { background: linear-gradient(var(--color-input-hover-bg-on-subtle-layer), var(--color-input-hover-bg-on-subtle-layer)), var(--color-input-bg-on-subtle); border: 2px solid var(--color-input-hover-border-on-subtle); padding-inline: 11px; }\n.tui-input[data-surface=\"gray\"]:focus-within { background: var(--color-input-focus-bg-on-subtle); }\n.tui-input:hover { background: var(--color-input-hover-bg-on-default); }\n.tui-input:focus-within { background: var(--color-input-focus-bg-on-default); }\n.tui-input[data-state=\"error\"] { border-color: var(--color-input-error-border); }\n.tui-input[data-state=\"disabled\"], .tui-search[data-state=\"disabled\"], .tui-input:has(input:disabled), .tui-search:has(input:disabled) { opacity: var(--state-disabled-opacity); }\n.tui-input input, .tui-search input { min-width: 0px; flex: 1 1 0%; padding: 0px; border: 0px; outline: 0px; color: inherit; background: transparent; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-input input::placeholder { color: var(--color-text-subtle); }\n.tui-form-field { width: 100%; display: grid; gap: var(--space-3); color: var(--color-text); font-family: var(--font-sans); }\n.tui-form-field > [data-slot=\"label\"] { display: inline-flex; align-items: baseline; gap: var(--space-1); color: var(--color-text); }\n.tui-form-field__required { color: var(--color-alert); }\n.tui-form-field__control, .tui-form-field__control > .tui-component { min-width: 0px; width: 100%; }\n.tui-form-field[data-required=\"true\"] > .tui-form-field__control { margin-inline-start: calc(1ch + var(--space-1)); width: calc(100% - 1ch - var(--space-1)); }\n.tui-form-field__error { color: var(--color-alert); }\n.tui-select { position: relative; width: 100%; display: grid; gap: var(--gap-field-label); color: var(--color-text); font-family: var(--font-sans); }\n.tui-select__trigger { min-height: var(--height-input); width: 100%; display: inline-flex; align-items: center; gap: var(--gap-menu-item-content); padding: 0 var(--padding-select-x); border: 1px solid transparent; border-radius: var(--radius-input); color: var(--color-text); background: var(--color-input-bg-on-default); font-family: var(--font-sans); cursor: pointer; text-align: start; }\n.tui-select__trigger:hover { background: var(--color-input-hover-bg-on-default); }\n.tui-select__trigger:focus-visible { background: var(--color-input-focus-bg-on-default); outline: 0px; }\n.tui-select[data-surface=\"gray\"] .tui-select__trigger { background: var(--color-input-bg-on-subtle); }\n.tui-select[data-surface=\"gray\"] .tui-select__trigger:hover { padding-inline: calc(var(--padding-select-x) - 1px); border: 2px solid var(--color-input-hover-border-on-subtle); background: linear-gradient(var(--color-input-hover-bg-on-subtle-layer), var(--color-input-hover-bg-on-subtle-layer)), var(--color-input-bg-on-subtle); }\n.tui-select[data-surface=\"gray\"] .tui-select__trigger:focus-visible { background: var(--color-input-focus-bg-on-subtle); outline: 0px; }\n.tui-select__trigger [data-slot=\"value\"] { min-width: 0px; flex: 1 1 0%; }\n.tui-select__trigger > .tui-icon { margin-inline-start: auto; width: var(--icon-size-sm); height: var(--icon-size-sm); transition: transform 0.16s; }\n.tui-select__menu { z-index: 20; position: absolute; inset: calc(100% + var(--space-2)) 0 auto; display: grid; gap: var(--gap-menu-item); padding: var(--padding-popup-menu); border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface-raised); }\n.tui-select__menu[hidden] { display: none; }\n.tui-select__menu [role=\"option\"] { min-height: var(--height-menu-item); width: 100%; display: flex; align-items: center; padding-inline: var(--padding-menu-item-x); border: 0px; border-radius: var(--radius-popup-menu-item); color: var(--color-text); background: transparent; font-family: var(--font-sans); text-align: start; cursor: pointer; }\n.tui-select__menu [role=\"option\"]:hover, .tui-select__menu [role=\"option\"][aria-selected=\"true\"] { background: var(--state-layer-hover); }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"16\"] [stroke] { stroke-width: 1; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-generated [data-typography-role=\"body-s\"], [data-typography-role=\"body-s\"] { font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); font-weight: var(--type-body-s-weight); }\n.tui-generated [data-typography-role=\"subtitle-s\"], [data-typography-role=\"subtitle-s\"] { font-size: var(--type-subtitle-s-size); line-height: var(--type-subtitle-s-leading); font-weight: var(--type-subtitle-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp .tui-runtime-form-field-states { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] { padding: 16px; border-radius: 12px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.06) 0px 0px 0px 1px inset; }\n.tp [data-surface-context=\"gray\"] { background: var(--color-bg-subtle,#0000000C); box-shadow: none; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
