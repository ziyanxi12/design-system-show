lots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">状态 <i>state</i></div><div class=\"tp-row\"><div class=\"tp-it\"><label class=\"tui-component tui-native-select\" data-component=\"native-select\" data-renderer-key=\"native-select\" data-logical-component=\"Native Select/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-surface=\"white\"><span data-slot=\"label\" data-typography-role=\"body-m\">视图</span><span class=\"tui-native-select__control\"><select data-slot=\"value\" data-typography-role=\"body-m\"><option selected>列表视图</option><option>网格视图</option><option>紧凑视图</option></select><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" data-icon-alias=\"navigation/chevron-down\" data-icon-size=\"16\" data-display-size-token=\"size/16\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></label><span class=\"tp-cap\">默认</span></div><div class=\"tp-it\"><label class=\"tui-component tui-native-select\" data-component=\"native-select\" data-renderer-key=\"native-select\" data-logical-component=\"Native Select/Default\" data-variant=\"default\" data-state=\"hover\" data-framework=\"html\" data-surface=\"white\"><span data-slot=\"label\" data-typography-role=\"body-m\">视图</span><span class=\"tui-native-select__control\"><select data-s