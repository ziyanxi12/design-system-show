       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--color-primary:var(--color-brand-100);--color-brand-100:#0A59F7FF;--radius-progress:var(--radius-full);--radius-full:999px;--height-progress:var(--size-1);--size-1:4px;--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--space-2:4px}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-progress { width: 100%; display: grid; gap: var(--space-2); color: var(--color-text); }\n.tui-progress__track { width: 100%; height: var(--height-progress); overflow: hidden; border-radius: var(--radius-progress); background: var(--color-bg-subtle); }\n.tui-progress__value { display: block; width: var(--progress-value, 0%); height: 100%; border-radius: inherit; background: var(--color-primary); transition: width 0.16s; }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gal