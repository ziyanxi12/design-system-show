       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-s-weight:var(--font-weight-400);--font-weight-400:400;--type-body-s-leading:var(--line-height-14);--line-height-14:14px;--type-body-s-size:var(--font-size-12);--font-size-12:12px;--type-body-m-weight:var(--font-weight-400);--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-primary:var(--color-brand-100);--color-brand-100:#0A59F7FF;--space-1:2px;--space-3:8px;--color-focus-ring:var(--color-brand-100);--color-button-ghost-hover-bg:var(--color-neutral-dark-05);--color-primary-text:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--color-button-ghost-bg:transparent;--color-button-ghost-text:var(--color-brand-100);--radius-button:var(--radius-3);--radius-3:8px;--padding-button-sm-x:var(--space-3);--height-button-sm:var(--size-8);--size-8:28px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--state-layer-pressed:var(--color-neutral-dark-10);--state-layer-hover:var(--color-neutral-dark-05);--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--radius-popup-menu-item:var(--radius-1);--radius-1:4px;--padding-menu-item-x:var(--space-4);--space-4:12px;--height-selection-block:var(--size-9);--size-9:32px;--shadow-2:0 0 20px 0 rgb(0 0 30 / 8%);--color-surface-raised:var(--color-neutral-light-100);--radius-card:var(--radius-4);--radius-4:12px;--padding-popup-menu:var(--space-2);--space-2:4px;--gap-menu-item:var(--space-1);--color-input-bg-on-default:var(--color-neutral-dark-05);--radius-input:var(--radius-3);--padding-select-x:var(--space-4);--gap-menu-item-content:var(--space-3);--height-input:var(--size-11);--size-11:40px;--gap-field-label:var(--space-3)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-advanced-menu__panel[hidden], .tui-advanced-popover__panel[hidden], .tui-picker__panel[hidden] { display: none; }\n.tui-picker { position: relative; display: grid; gap: var(--gap-field-label); min-width: 240px; color: var(--color-text); }\n.tui-picker > label { color: var(--color-text); }\n.tui-picker__trigger { min-height: var(--height-input); display: flex; align-items: center; gap: var(--gap-menu-item-content); padding-inline: var(--padding-select-x); border: 1px solid transparent; border-radius: var(--radius-input); color: var(--color-text); background: var(--color-input-bg-on-default); font: inherit; cursor: pointer; }\n.tui-picker__trigger > .tui-icon:last-child { margin-inline-start: auto; }\n.tui-picker__panel { z-index: 10; position: absolute; inset: calc(100% + var(--space-2)) 0 auto; display: grid; gap: var(--gap-menu-item); min-width: 240px; padding: var(--padding-popup-menu); border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface-raised); box-shadow: var(--shadow-2); }\n.tui-picker__panel:has(> .tui-calendar) { min-width: 320px; }\n.tui-picker__columns button { width: 100%; min-width: 0px; min-height: var(--height-selection-block); padding-inline: var(--padding-menu-item-x); border: 0px; border-radius: var(--radius-popup-menu-item); color: var(--color-text); background: transparent; font: inherit; cursor: pointer; }\n.tui-picker__calendar button:hover, .tui-picker__columns button:hover, .tui-picker__columns button:focus-visible { background: var(--state-layer-hover); outline: 0px; }\n.tui-picker__columns button:active { background: var(--state-layer-pressed); }\n.tui-picker__panel footer { display: flex; justify-content: flex-end; gap: var(--space-3); border-top: 1px solid var(--color-border); padding-top: var(--space-3); }\n.tui-picker__panel footer button { min-height: var(--height-button-sm); padding-inline: var(--padding-button-sm-x); border: 0px; border-radius: var(--radius-button); color: var(--color-button-ghost-text); background: var(--color-button-ghost-bg); font: inherit; cursor: pointer; }\n.tui-picker__panel footer button:last-child { color: var(--color-primary-text); background: var(--color-primary); }\n.tui-picker__panel footer button:hover { background: var(--color-button-ghost-hover-bg); }\n.tui-picker__panel footer button:last-child:hover { background: var(--color-primary); }\n.tui-picker__panel footer button:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 1px; }\n.tui-picker__columns { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-3); text-align: center; }\n.tui-picker__columns > div { display: grid; gap: var(--space-1); }\n.tui-picker__columns button.is-selected { color: var(--color-primary); background: transparent; }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\n.tui-generated [data-typography-role=\"body-s\"], [data-typography-role=\"body-s\"] { font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); font-weight: var(--type-body-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
      }
