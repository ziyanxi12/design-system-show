       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--icon-size-md:var(--size-6);--size-6:20px;--color-text-subtle:var(--color-neutral-dark-40);--color-neutral-dark-40:#00000066;--color-brand-10:#0A59F719;--type-subtitle-m-weight:var(--font-weight-500);--font-weight-500:500;--type-subtitle-m-leading:var(--line-height-20);--type-subtitle-m-size:var(--font-size-16);--color-sidebar-selected:var(--color-brand-10);--color-sidebar-selected-text:var(--color-brand-100);--color-brand-100:#0A59F7FF;--state-layer-pressed:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--color-sidebar-accent:var(--color-neutral-dark-05);--radius-sidebar-nav-item:var(--radius-3);--radius-3:8px;--gap-menu-item-content:var(--space-3);--space-3:8px;--space-4:12px;--height-list-item:var(--size-11);--size-11:40px;--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--space-0:0px;--space-1:2px;--color-focus-ring:var(--color-brand-100)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button:focus-visible, .tui-sidebar-item:focus-visible, .tui-primary-navigation-item:focus-visible, .tui-list-card:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-sidebar { display: grid; gap: var(--space-1); align-content: start; padding: var(--space-0); color: var(--color-text); background: transparent; }\n.tui-sidebar-item { width: 100%; min-height: var(--height-list-item); padding: 0 var(--space-4); display: flex; align-items: center; gap: var(--gap-menu-item-content); border: 0px; border-radius: var(--radius-sidebar-nav-item); color: var(--color-text-muted); background: transparent; text-align: left; cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-sidebar-item:hover:not(:disabled), .tui-sidebar-item[data-state=\"hover\"] { color: var(--color-text-muted); background: var(--color-sidebar-accent); }\n.tui-sidebar-item:active:not(:disabled), .tui-sidebar-item[data-state=\"pressed\"] { color: var(--color-text-muted); background: var(--state-layer-pressed); }\n.tui-sidebar-item[data-state=\"selected\"] { color: var(--color-sidebar-selected-text); background: var(--color-sidebar-selected); }\n.tui-sidebar-item[data-state=\"selected\"] [data-slot=\"label\"] { font-size: var(--type-subtitle-m-size); line-height: var(--type-subtitle-m-leading); font-weight: var(--type-subtitle-m-weight); }\n.tui-sidebar-item[data-state=\"selected\"]:hover:not(:disabled) { background: linear-gradient(var(--color-neutral-dark-05), var(--color-neutral-dark-05)), var(--color-brand-10); }\n.tui-sidebar-item:disabled, .tui-sidebar-item[data-state=\"disabled\"] { color: var(--color-text-subtle); cursor: not-allowed; }\n.tui-sidebar-item [data-slot=\"leading\"] { width: var(--icon-size-md); height: var(--icon-size-md); display: inline-grid; place-items: center; flex: 0 0 var(--icon-size-md); }\n.tui-sidebar-item [data-slot=\"leading\"] svg { width: 100%; height: 100%; display: block; }\n.tui-sidebar-item__count { margin-inline-start: auto; color: var(--color-text-muted); font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
      }
     ]
    }
