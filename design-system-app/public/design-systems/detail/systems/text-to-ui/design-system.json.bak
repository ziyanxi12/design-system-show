       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-body-m-weight:var(--font-weight-400);--font-weight-400:400;--type-body-m-leading:var(--line-height-16);--line-height-16:16px;--type-body-m-size:var(--font-size-14);--font-size-14:14px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--color-surface:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--color-text:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--space-3:8px;--space-4:12px;--height-input:var(--size-11);--size-11:40px;--state-layer-hover:var(--color-neutral-dark-05);--icon-size-sm:var(--size-5);--size-5:16px;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--radius-input:var(--radius-3);--radius-3:8px;--space-2:4px;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-segmented-button__item:focus-visible, .tui-number-selector__step:focus-visible, .tui-number-selector input:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }\n.tui-segmented-button__item:disabled, .tui-number-selector:has(:disabled) { opacity: var(--state-disabled-opacity); cursor: not-allowed; }\n.tui-number-selector { display: inline-grid; gap: var(--space-2); color: var(--color-text); }\n.tui-number-selector__control { height: var(--height-input); display: inline-flex; align-items: stretch; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-input); background: var(--color-surface); }\n.tui-number-selector__stepper { width: var(--height-input); display: grid; grid-template-rows: repeat(2, minmax(0px, 1fr)); border-inline-start: 1px solid var(--color-border); background: var(--color-surface); }\n.tui-number-selector__step { display: grid; place-items: center; padding: 0px; border: 0px; color: var(--color-text); background: transparent; cursor: pointer; }\n.tui-number-selector__step + .tui-number-selector__step { border-block-start: 1px solid var(--color-border); }\n.tui-number-selector__step .tui-icon { width: var(--icon-size-sm); height: var(--icon-size-sm); }\n.tui-number-selector__step:hover:not(:disabled) { background: var(--state-layer-hover); }\n.tui-number-selector input { width: calc(var(--height-input) + var(--space-4)); min-width: 0px; padding: 0 var(--space-3); border: 0px; outline: 0px; appearance: textfield; color: var(--color-text); background: var(--color-surface); text-align: center; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-number-selector input::-webkit-inner-spin-button, .tui-number-selector input::-webkit-outer-spin-button { margin: 0px; appearance: none; }\n.tui-number-selector input:focus { background: var(--color-surface); }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"16\"] [stroke] { stroke-width: 1; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-m\"], [data-typography-role=\"body-m\"] { font-size: var(--type-body-m-size); line-height: var(--type-body-m-leading); font-weight: var(--type-body-m-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
      }
     ]
    }
   },
   {
    "id": "checkbox",
