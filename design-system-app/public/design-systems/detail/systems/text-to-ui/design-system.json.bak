      {
       "path": "packages/component-styles/src/index.css",
       "lang": "css",
       "code": ":root{--color-bg-subtle:var(--color-neutral-dark-05);--color-neutral-dark-05:#0000000C;--font-sans:\"HarmonyOS Sans\", \"HarmonyOS Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;--type-subtitle-s-weight:var(--font-weight-500);--font-weight-500:500;--type-subtitle-s-leading:var(--line-height-16);--line-height-16:16px;--type-subtitle-s-size:var(--font-size-14);--font-size-14:14px;--type-body-s-weight:var(--font-weight-400);--font-weight-400:400;--type-body-s-leading:var(--line-height-14);--line-height-14:14px;--type-body-s-size:var(--font-size-12);--font-size-12:12px;--type-body-l-weight:var(--font-weight-400);--type-body-l-leading:var(--line-height-20);--line-height-20:20px;--type-body-l-size:var(--font-size-16);--font-size-16:16px;--state-disabled-opacity:var(--opacity-40);--opacity-40:0.4;--space-2:4px;--icon-size-md:var(--size-6);--size-6:20px;--color-icon:var(--color-neutral-dark-90);--color-neutral-dark-90:#000000E5;--size-icon-button:var(--size-11);--size-11:40px;--color-text-muted:var(--color-neutral-dark-60);--color-neutral-dark-60:#00000099;--space-0:0px;--color-danger-subtle:var(--color-function-danger-10);--color-function-danger-10:#E8402619;--color-danger:var(--color-function-danger-100);--color-function-danger-100:#E84026FF;--radius-badge:var(--radius-full);--radius-full:999px;--height-input:var(--size-11);--radius-card:var(--radius-4);--radius-4:12px;--space-4:12px;--space-3:8px;--color-focus-ring:var(--color-brand-100);--color-brand-100:#0A59F7FF;--state-layer-hover:var(--color-neutral-dark-05);--color-text:var(--color-neutral-dark-90);--color-icon-muted:var(--color-neutral-dark-60);--radius-icon-button:var(--radius-3);--radius-3:8px;--icon-size-sm:var(--size-5);--size-5:16px;--radius-popup-menu-item:var(--radius-1);--radius-1:4px;--padding-menu-item-x:var(--space-4);--height-menu-item:var(--size-11);--shadow-2:0 0 20px 0 rgb(0 0 30 / 8%);--color-surface-raised:var(--color-neutral-light-100);--color-neutral-light-100:#FFFFFFFF;--color-border:var(--color-neutral-dark-10);--color-neutral-dark-10:#00000019;--padding-popup-menu:var(--space-2)}\n:where(.tui-component, .tui-component *) { box-sizing: border-box; }\n:where(.tui-component) { font-family: var(--font-sans); }\n:where(.tui-button, .tui-input, .tui-search, .tui-sidebar-item, .tui-primary-navigation-item, .tui-list-card) { font: inherit; }\n.tui-button-dropdown__menu { z-index: 20; min-width: 168px; padding: var(--padding-popup-menu); position: absolute; top: calc(100% + var(--space-2)); left: 0px; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface-raised); box-shadow: var(--shadow-2); }\n.tui-button-dropdown__menu[hidden] { display: none; }\n.tui-button-dropdown__item { width: 100%; height: var(--height-menu-item); padding: 0 var(--padding-menu-item-x); display: flex; align-items: center; border: 0px; border-radius: var(--radius-popup-menu-item); color: var(--color-text); background: transparent; cursor: pointer; font-family: var(--font-sans); font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); text-align: left; white-space: nowrap; }\n.tui-button-dropdown__item:hover, .tui-button-dropdown__item:focus-visible { background: var(--state-layer-hover); outline: 0px; }\n.tui-icon-button svg { width: var(--icon-size-sm); height: var(--icon-size-sm); display: block; }\n.tui-icon-button { width: var(--size-icon-button); height: var(--size-icon-button); padding: 0px; display: inline-grid; place-items: center; border: 0px; border-radius: var(--radius-icon-button); color: var(--color-icon-muted); background: transparent; cursor: pointer; }\n.tui-icon-button:hover { color: var(--color-text); background: var(--state-layer-hover); }\n.tui-icon-button:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 1px; }\n.tui-attachment { position: relative; min-width: 260px; display: flex; align-items: center; gap: var(--space-3); padding-block: var(--space-3); padding-inline: var(--space-4); border: 0px; border-radius: var(--radius-card); background: var(--color-neutral-dark-05); }\n.tui-attachment__type { min-width: var(--height-input); min-height: var(--height-input); display: grid; place-items: center; border-radius: var(--radius-badge); color: var(--color-danger); background: var(--color-danger-subtle); }\n.tui-attachment > div { min-width: 0px; display: grid; gap: var(--space-0); }\n.tui-attachment small { color: var(--color-text-muted); font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); font-weight: var(--type-body-s-weight); }\n.tui-attachment__actions { position: relative; margin-inline-start: auto; display: inline-flex; align-items: center; flex: 0 0 var(--size-icon-button); }\n.tui-attachment__menu-trigger { color: var(--color-icon); }\n.tui-attachment__menu-trigger > .tui-icon { width: var(--icon-size-md); height: var(--icon-size-md); transition: transform 0.16s; }\n.tui-attachment__menu { top: calc(100% + var(--space-2)); right: 0px; left: auto; }\n.tui-attachment[data-state=\"disabled\"] .tui-attachment__actions { opacity: var(--state-disabled-opacity); }\n.tui-icon { display: inline-block; flex: 0 0 auto; color: currentcolor; overflow: visible; }\n.tui-icon--regular { fill: currentcolor; }\n.tui-icon--regular [fill=\"none\"] { fill: none; }\n.tui-icon--regular [stroke] { stroke: currentcolor; }\n.tui-icon--regular[data-icon-size=\"20\"] [stroke] { stroke-width: 1.25; }\n.tui-generated [data-typography-role=\"body-l\"], [data-typography-role=\"body-l\"] { font-size: var(--type-body-l-size); line-height: var(--type-body-l-leading); font-weight: var(--type-body-l-weight); }\n.tui-generated [data-typography-role=\"body-s\"], [data-typography-role=\"body-s\"] { font-size: var(--type-body-s-size); line-height: var(--type-body-s-leading); font-weight: var(--type-body-s-weight); }\n.tui-generated [data-typography-role=\"subtitle-s\"], [data-typography-role=\"subtitle-s\"] { font-size: var(--type-subtitle-s-size); line-height: var(--type-subtitle-s-leading); font-weight: var(--type-subtitle-s-weight); }\nbody { background: rgb(255, 255, 255); display: block !important; padding: 24px 28px !important; }\n.tp { display: flex; flex-direction: column; gap: 22px; font-family: var(--font-sans); }\n.tp-sec { display: flex; flex-direction: column; gap: 10px; max-width: 100%; }\n.tp-l { font-size: 12px; color: rgb(138, 138, 138); }\n.tp-l i { font-style: normal; color: rgb(181, 181, 181); margin-left: 4px; }\n.tp-row { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp-it { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 64px; max-width: 100%; }\n.tp-cap { font-size: 11px; color: rgb(154, 154, 154); line-height: 14px; white-space: nowrap; }\n.tp-it > :first-child { max-width: 100%; }\n.tp :is(.tui-runtime-core-gallery, .tui-runtime-form-field-states, .tui-runtime-titlebar-gallery, .tui-feedback-specimens, .tui-list-card-group, .tui-runtime-titlebar-layouts) { display: flex; flex-direction: column; gap: 16px; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-avatar-pair, .tui-runtime-structural-grid, .tui-runtime-surface-grid, .tui-runtime-state-grid, .tui-runtime-chips-gallery, .tui-badge-group, .tui-primary-navigation-items) { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-start; }\n.tp :is(.tui-runtime-surface-pair, .tui-runtime-form-field-states) > [data-surface-context] { flex: 1 1 280px; min-width: 0px; }\n.tp :is(.tui-runtime-structural-cell, .tui-runtime-state-cell, .tui-feedback-specimen, .tui-runtime-avatar-pair > div, [data-surface-context]) { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; min-width: 0px; }\n.tp [data-surface-context] > :not(.tui-runtime-surface-label) { width: 100%; }\n.tp :is(.tui-runtime-surface-label, .tui-runtime-titlebar-scenario-slots) { display: block; font-size: 12px; line-height: 16px; font-weight: 400; color: rgb(138, 138, 138); white-space: normal; }\n.tp :is(.tui-runtime-titlebar-size-title, .tui-runtime-titlebar-scenario-title) { display: block; margin: 0px; font-size: 13px; line-height: 18px; font-weight: 500; color: rgb(85, 85, 85); }"
      }
     ]
    }
   }
  ]
 },
