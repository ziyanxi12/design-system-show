       "path": "packages/components-html/src/index.js#renderRuntimeHtmlComponent(context-menu)",
       "lang": "html",
       "code": "<style>body{display:block!important;padding:24px 28px!important;background:#fff}\n.tp{display:flex;flex-direction:column;gap:22px;font-family:var(--font-sans)}\n.tp-sec{display:flex;flex-direction:column;gap:10px;max-width:100%}\n.tp-l{font-size:12px;color:#8a8a8a}.tp-l i{font-style:normal;color:#b5b5b5;margin-left:4px}\n.tp-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp-it{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:64px;max-width:100%}\n.tp-cap{font-size:11px;color:#9a9a9a;line-height:14px;white-space:nowrap}\n.tp-it>*:first-child{max-width:100%}\n/* 规范仓库的组件示例集（renderRuntimeHtmlComponent）用到的外层排版类，仓库精简版里没有对应样式，这里补齐 */\n.tp :is(.tui-runtime-core-gallery,.tui-runtime-form-field-states,.tui-runtime-titlebar-gallery,.tui-feedback-specimens,.tui-list-card-group,.tui-runtime-titlebar-layouts){display:flex;flex-direction:column;gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-avatar-pair,.tui-runtime-structural-grid,.tui-runtime-surface-grid,.tui-runtime-state-grid,.tui-runtime-chips-gallery,.tui-badge-group,.tui-primary-navigation-items){display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp .tui-runtime-form-field-states{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-form-field-states)>[data-surface-context]{flex:1 1 280px;min-width:0}\n.tp :is(.tui-runtime-structural-cell,.tui-runtime-state-cell,.tui-feedback-specimen,.tui-runtime-avatar-pair>div,[data-surface-context]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}\n.tp [data-surface-context]{padding:16px;border-radius:12px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}\n.tp [data-surface-context=\"gray\"]{background:var(--color-bg-subtle,#0000000C);box-shadow:none}\n.tp [data-surface-context]>*:not(.tui-runtime-surface-label){width:100%}\n.tp :is(.tui-runtime-surface-label,.tui-runtime-titlebar-scenario-slots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">状态 <i>state</i></div><div class=\"tp-row\"><div class=\"tp-it\"><div class=\"tui-component tui-advanced-menu\" data-component=\"context-menu\" data-renderer-key=\"context-menu\" data-logical-component=\"Context Menu/Default\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\"><span class=\"tui-advanced-menu__label\" data-typography-role=\"body-m\">更多操作</span><button class=\"tui-advanced-menu__trigger\" type=\"button\" aria-label=\"更多操作\" aria-haspopup=\"menu\" aria-expanded=\"false\"><span data-slot=\"value\" data-typography-role=\"body-l\">右键或点击打开</span><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" data-icon-alias=\"navigation/chevron-down\" data-icon-size=\"16\" data-display-size-token=\"size/16\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><div class=\"tui-advanced-menu__panel\" role=\"menu\" hidden><div class=\"tui-advanced-menu__item-wrap\"><button type=\"button\" role=\"menuitem\" class=\"tui-advanced-menu__item\" data-typography-role=\"body-l\"><span class=\"tui-advanced-menu__item-leading\" data-slot=\"leading\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" data-icon-alias=\"action/copy\" data-icon-size=\"24\" data-display-siz