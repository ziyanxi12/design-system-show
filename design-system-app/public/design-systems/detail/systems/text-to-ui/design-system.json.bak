       "lang": "html",
       "code": "<style>body{display:block!important;padding:24px 28px!important;background:#fff}\n.tp{display:flex;flex-direction:column;gap:22px;font-family:var(--font-sans)}\n.tp-sec{display:flex;flex-direction:column;gap:10px;max-width:100%}\n.tp-l{font-size:12px;color:#8a8a8a}.tp-l i{font-style:normal;color:#b5b5b5;margin-left:4px}\n.tp-row{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp-it{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:64px;max-width:100%}\n.tp-cap{font-size:11px;color:#9a9a9a;line-height:14px;white-space:nowrap}\n.tp-it>*:first-child{max-width:100%}\n/* 规范仓库的组件示例集（renderRuntimeHtmlComponent）用到的外层排版类，仓库精简版里没有对应样式，这里补齐 */\n.tp :is(.tui-runtime-core-gallery,.tui-runtime-form-field-states,.tui-runtime-titlebar-gallery,.tui-feedback-specimens,.tui-list-card-group,.tui-runtime-titlebar-layouts){display:flex;flex-direction:column;gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-avatar-pair,.tui-runtime-structural-grid,.tui-runtime-surface-grid,.tui-runtime-state-grid,.tui-runtime-chips-gallery,.tui-badge-group,.tui-primary-navigation-items){display:flex;flex-wrap:wrap;gap:16px 24px;align-items:flex-start}\n.tp .tui-runtime-form-field-states{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}\n.tp :is(.tui-runtime-surface-pair,.tui-runtime-form-field-states)>[data-surface-context]{flex:1 1 280px;min-width:0}\n.tp :is(.tui-runtime-structural-cell,.tui-runtime-state-cell,.tui-feedback-specimen,.tui-runtime-avatar-pair>div,[data-surface-context]){display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}\n.tp [data-surface-context]{padding:16px;border-radius:12px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06)}\n.tp [data-surface-context=\"gray\"]{background:var(--color-bg-subtle,#0000000C);box-shadow:none}\n.tp [data-surface-context]>*:not(.tui-runtime-surface-label){width:100%}\n.tp :is(.tui-runtime-surface-label,.tui-runtime-titlebar-scenario-slots){display:block;font-size:12px;line-height:16px;font-weight:400;color:#8a8a8a;white-space:normal}\n.tp :is(.tui-runtime-titlebar-size-title,.tui-runtime-titlebar-scenario-title){display:block;margin:0;font-size:13px;line-height:18px;font-weight:500;color:#555}\n.tp .tui-runtime-note{margin:0;font-size:12px;line-height:18px;color:#8a8a8a}\n.tp .tui-runtime-titlebar-layout-shell{display:flex;width:100%;margin-top:6px;border-radius:8px;box-shadow:inset 0 0 0 1px rgba(0,0,0,.06);overflow:hidden}</style><div class=\"tp\"><div class=\"tp-sec\"><div class=\"tp-l\">规范示例 <i>specimens</i></div><div class=\"tui-runtime-core-gallery tui-runtime-primary-navigation-gallery\"><p class=\"tui-runtime-note\">一级导航使用独立的原生 Primary Navigation Item；Pattern 只负责把它放入底部对齐的 primary-navigation-shell。</p><nav class=\"tui-primary-navigation-items\" aria-label=\"一级导航\"><button class=\"tui-component tui-primary-navigation-item\" type=\"button\" data-component=\"primary-navigation-item\" data-renderer-key=\"primary-navigation-item\" data-logical-component=\"Primary Navigation Item/Level 1\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-placement=\"primary-navigation-shell\" data-mode=\"icon-only\" aria-label=\"工作台\" aria-pressed=\"false\"><span data-slot=\"icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" data-icon-alias=\"navigation/grid\" data-icon-size=\"24\" data-display-size-token=\"size/24\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect width=\"7\" height=\"7\" x=\"14\" y=\"3\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect width=\"7\" height=\"7\" x=\"14\" y=\"14\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></button><button class=\"tui-component tui-primary-navigation-item\" type=\"button\" data-component=\"primary-navigation-item\" data-renderer-key=\"primary-navigation-item\" data-logical-component=\"Primary Navigation Item/Level 1\" data-variant=\"selected\" data-state=\"selected\" data-framework=\"html\" data-placement=\"primary-navigation-shell\" data-mode=\"icon-only\" aria-label=\"项目\" aria-pressed=\"true\"><span data-slot=\"icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" data-icon-alias=\"field/calendar\" data-icon-size=\"24\" data-display-size-token=\"size/24\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M8 2v4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M16 2v4\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M3 10h18\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M8 14h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 14h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M16 14h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M8 18h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 18h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M16 18h.01\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></button><button class=\"tui-component tui-primary-navigation-item\" type=\"button\" data-component=\"primary-navigation-item\" data-renderer-key=\"primary-navigation-item\" data-logical-component=\"Primary Navigation Item/Level 1\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-placement=\"primary-navigation-shell\" data-mode=\"icon-only\" aria-label=\"消息\" aria-pressed=\"false\"><span data-slot=\"icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" data-icon-alias=\"navigation/mail-unread\" data-icon-size=\"24\" data-display-size-token=\"size/24\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></button><button class=\"tui-component tui-primary-navigation-item\" type=\"button\" data-component=\"primary-navigation-item\" data-renderer-key=\"primary-navigation-item\" data-logical-component=\"Primary Navigation Item/Level 1\" data-variant=\"default\" data-state=\"default\" data-framework=\"html\" data-placement=\"primary-navigation-shell\" data-mode=\"icon-only\" aria-label=\"设置\" aria-pressed=\"false\"><span data-slot=\"icon\"><svg class=\"tui-icon tui-icon--regular\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" data-icon-alias=\"action/settings\" data-icon-size=\"24\" data-display-size-token=\"size/24\" data-icon-kind=\"regular\" data-icon-source=\"lucide@1.24.0\" aria-hidden=\"true\"><path d=\"M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"3\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></button></nav></div></div></div>"
